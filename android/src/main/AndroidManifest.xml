<?xml version="1.0" encoding="utf-8"?>
<!-- The package name, version, and SDK levels are in build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep.kt: June puts back her assistant settings and hands when Android clears them. Granted over ADB by the install
         app; it cannot be granted any other way. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reminders.kt: exact alarms at timed SCHEDULED and DEADLINE entries, as Bloom set them, and their notices. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- AgendaJob.kt refreshes the agenda only while there is a network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Links.kt: a herdr: link opens a Termux session attached to the agent's terminal. Granted over ADB. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- June opens apps by name through her hands: the launcher's apps must be visible to her. -->
    <queries>
        <!-- Termux, which opens herdr links, and Emacs, which opens file links (Links.kt); the Herdr app and Emacs are
             the default sideways swipes (Swipes.kt). -->
        <package android:name="com.termux" />
        <package android:name="org.gnu.emacs" />
        <package android:name="dev.herdr.app" />
        <!-- The ntfy app, June's UnifiedPush distributor for agenda pushes (Push.kt). -->
        <package android:name="io.heckel.ntfy" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:label="June" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Settings: pairing, role status, a way into Default apps, and the last invocation's report. The system opens it
             from the assistant's settings too, so it is exported. -->
        <activity android:name=".MainActivity" android:exported="true" android:label="June settings" />

        <!-- June's conversation full screen, the launcher entry. From the lock screen it covers it and asks Android to
             unlock. -->
        <activity android:name=".ConversationActivity" android:exported="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A tap on June's ntfy notification opens the conversation (src/ntfy.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="june" android:host="conversation" />
            </intent-filter>
            <!-- The agenda widget and reminders: june://task?key=KEY opens a task's page, june://projects the board.
                 Not BROWSABLE, so a web page cannot open them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="june" android:host="task" />
                <data android:scheme="june" android:host="projects" />
            </intent-filter>
            <!-- A moment in June's history from another app, such as a link in Org: june://at/ID opens its day there. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="june" android:host="at" />
            </intent-filter>
        </activity>

        <!-- A herdr: link from another app, such as a tap on an agent notice in ntfy, opens like one in June's words
             (HerdrLinkActivity.kt). Not BROWSABLE, so a web page cannot start it. -->
        <activity android:name=".HerdrLinkActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="herdr" />
            </intent-filter>
        </activity>

        <!-- The invisible step to the photo picker, file picker, or camera (AttachActivity.kt). -->
        <activity android:name=".AttachActivity" android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- After an app update or a boot, June checks her assistant settings and hands are still on (Keep.kt). -->
        <receiver android:name=".KeepReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- June's agenda on the home screen, in place of Bloom's (AgendaWidget.kt), kept fresh by AgendaJob.kt, with
             reminders from it (Reminders.kt), all set again after a boot or an update (AgendaBootReceiver). -->
        <receiver android:name=".AgendaWidget" android:exported="true" android:label="June agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget" />
        </receiver>
        <service android:name=".AgendaJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- The widget's taps (WidgetActions.kt): an invisible screen that opens a task or sends its DONE, the job that
             sends it, and the small box behind its + that hands June a TODO to add. -->
        <activity android:name=".WidgetTapActivity" android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:noHistory="true"
            android:taskAffinity="" />
        <service android:name=".TaskEditJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity android:name=".ViewPickerActivity" android:exported="false" android:label="Show in widget"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" android:excludeFromRecents="true"
            android:taskAffinity="" />
        <activity android:name=".StatePickerActivity" android:exported="false" android:label="Change state"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" android:excludeFromRecents="true"
            android:taskAffinity="" />
        <activity android:name=".QuickAddActivity" android:exported="false" android:label="Add a TODO"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" android:excludeFromRecents="true"
            android:taskAffinity="" android:windowSoftInputMode="stateVisible" />
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <!-- ntfy's UnifiedPush answers and pushes (Push.kt); a broadcast without June's token is dropped. -->
        <receiver android:name=".PushReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".AgendaBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lends the camera the one file it writes a photo into, under the cache. -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="net.suderman.june.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/files" />
        </provider>

        <!-- Pairing over ADB; only the shell and the system hold this permission, so no app can re-pair June. Its own task,
             so the install app starting it never brings June's conversation to the front. -->
        <activity android:name=".PairActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true" />

        <!-- Declaring this service is what makes the app eligible for Digital assistant app. -->
        <service android:name=".JuneInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service android:name=".JuneSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- June's hands on the phone (Hands.kt), on by Jon's choice; the install app turns it on over ADB. Its own
             process, so a crash in the conversation never takes it down: Android leaves a crashed accessibility service
             off until it is turned on again. -->
        <service android:name=".Hands" android:label="June's hands" android:process=":hands"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/hands" />
        </service>

        <!-- Stub: the system may refuse a voice interaction service without one. It recognizes nothing. -->
        <service android:name=".JuneRecognitionService" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
