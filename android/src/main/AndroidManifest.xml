<?xml version="1.0" encoding="utf-8"?>
<!-- The package name, version, and SDK levels are in build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep.kt: June puts back her assistant settings and hands when Android clears them. Granted over ADB by the install
         app; it cannot be granted any other way. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Links.kt: a herdr: link in June's words opens a Termux session attached to the agent's pane. Granted over ADB. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- June opens apps by name through her hands: the launcher's apps must be visible to her. -->
    <queries>
        <!-- Termux, which opens herdr links (Links.kt). -->
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:label="June" android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Settings: pairing, role status, a way into Default apps, and the last invocation's report. The system opens it
             from the assistant's settings too, so it is exported. -->
        <activity android:name=".MainActivity" android:exported="true" android:label="June settings" />

        <!-- June's conversation full screen, the launcher entry. From the lock screen it covers it and asks Android to
             unlock. -->
        <activity android:name=".ConversationActivity" android:exported="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The invisible step to the photo picker, file picker, or camera (AttachActivity.kt). -->
        <activity android:name=".AttachActivity" android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- After an app update or a boot, June checks her assistant settings and hands are still on (Keep.kt). -->
        <receiver android:name=".KeepReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lends the camera the one file it writes a photo into, under the cache. -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="net.suderman.june.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/files" />
        </provider>

        <!-- Pairing over ADB; only the shell and the system hold this permission, so no app can re-pair June. -->
        <activity android:name=".PairActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" />

        <!-- Declaring this service is what makes the app eligible for Digital assistant app. -->
        <service android:name=".JuneInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service android:name=".JuneSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- June's hands on the phone (Hands.kt), on by Jon's choice; the install app turns it on over ADB. Its own
             process, so a crash in the conversation never takes it down: Android leaves a crashed accessibility service
             off until it is turned on again. -->
        <service android:name=".Hands" android:label="June's hands" android:process=":hands"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/hands" />
        </service>

        <!-- Stub: the system may refuse a voice interaction service without one. It recognizes nothing. -->
        <service android:name=".JuneRecognitionService" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
