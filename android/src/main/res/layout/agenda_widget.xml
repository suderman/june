<?xml version="1.0" encoding="utf-8"?>
<!-- June's agenda on the home screen (AgendaWidget.kt): a header with what is due and how fresh it is, then the rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/agenda_widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/agenda_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/agenda_choose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agenda_view_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda ▾"
                android:textColor="@color/agenda_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/agenda_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/agenda_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/agenda_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Add a TODO"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/agenda_ink"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/agenda_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Refresh"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/agenda_ink"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agenda_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/agenda_chip_agenda"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.35"
            android:background="@drawable/agenda_chip_off"
            android:gravity="center"
            android:maxLines="1"
            android:text="Agenda"
            android:textColor="@color/agenda_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_chip_todo"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/agenda_chip_off"
            android:gravity="center"
            android:maxLines="1"
            android:text="TODO"
            android:textColor="@color/agenda_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_chip_prog"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/agenda_chip_off"
            android:gravity="center"
            android:maxLines="1"
            android:text="PROG"
            android:textColor="@color/agenda_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_chip_eval"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/agenda_chip_off"
            android:gravity="center"
            android:maxLines="1"
            android:text="EVAL"
            android:textColor="@color/agenda_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_chip_hold"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/agenda_chip_off"
            android:gravity="center"
            android:maxLines="1"
            android:text="HOLD"
            android:textColor="@color/agenda_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_chip_auto"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/agenda_chip_off"
            android:gravity="center"
            android:maxLines="1"
            android:text="AUTO"
            android:textColor="@color/agenda_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/agenda_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/agenda_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Open June once to fetch the agenda."
        android:textColor="@color/agenda_muted"
        android:textSize="13sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="4dp"
        android:background="@color/agenda_rule"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/agenda_tabs"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/agenda_tab_terminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Terminal"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tab_terminal" />

        <ImageView
            android:id="@+id/agenda_tab_agents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Agents"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tab_agents" />

        <ImageView
            android:id="@+id/agenda_tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Chat"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tab_chat" />

        <ImageView
            android:id="@+id/agenda_tab_projects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Projects"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tab_projects" />

        <ImageView
            android:id="@+id/agenda_tab_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Editor"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tab_editor" />
    </LinearLayout>
</LinearLayout>
