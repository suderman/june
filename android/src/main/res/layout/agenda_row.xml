<?xml version="1.0" encoding="utf-8"?>
<!-- One agenda line: its time, then the title and what it is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ○ marks a task DONE; an event has none. -->
    <TextView
        android:id="@+id/agenda_done"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Mark done"
        android:gravity="center"
        android:text="○"
        android:textColor="@color/agenda_muted"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/agenda_time"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:paddingTop="1dp"
        android:textColor="@color/agenda_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/agenda_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/agenda_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/agenda_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/agenda_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
