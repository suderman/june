#!/usr/bin/env bash
set -euo pipefail

# Run autonomous Org tasks with pi in Herdr.
#
#   org-dispatch [run]                 watch running tasks, then launch eligible ones
#   org-dispatch scan                  list tasks this host would launch now
#   org-dispatch reconcile --dry-run   show which panes an enabled run would retire
#   org-dispatch finish ID STATE [NOTE] [--headline LINE]  end as EVAL, HOLD, or DONE
#   org-dispatch retry ID WHEN NOTE    return a task Jon allowed to retry to AUTO at WHEN
# The Nix wrapper sets ORG_DISPATCH_EL; from a checkout, use the file beside this one.
: "${ORG_DISPATCH_EL:=$(dirname "$(readlink -f "$0")")/org-dispatch.el}"
# org-dispatch.el pins Calgary time; without zone data Emacs silently runs in UTC,
# so evenings would date tomorrow. NixOS keeps zones in /etc/zoneinfo, not the libc default.
if [[ -z ${TZDIR:-} && ! -d /usr/share/zoneinfo && -d /etc/zoneinfo ]]; then export TZDIR=/etc/zoneinfo; fi
batch=(emacs -Q --batch -l "$ORG_DISPATCH_EL")

case ${1:-run} in
  run) exec flock -n "${XDG_RUNTIME_DIR:-/tmp}/org-dispatch.lock" "${batch[@]}" -f org-dispatch-run ;;
  scan) exec "${batch[@]}" -f org-dispatch-scan ;;
  reconcile)
    [[ $# -eq 2 && $2 == --dry-run ]] || { echo "only reconcile --dry-run is supported; enabled runs retire panes" >&2; exit 2; }
    shift
    exec "${batch[@]}" -f org-dispatch-reconcile "$@"
    ;;
  finish)
    [[ $# -ge 3 ]] || { echo "usage: org-dispatch finish ID EVAL|HOLD|DONE [NOTE] [--headline LINE]" >&2; exit 2; }
    shift
    exec flock -n "${XDG_RUNTIME_DIR:-/tmp}/org-dispatch.lock" "${batch[@]}" -f org-dispatch-finish "$@"
    ;;
  plan)
    [[ $# -eq 2 ]] || { echo "usage: org-dispatch plan SPEC.json" >&2; exit 2; }
    shift
    exec "${batch[@]}" -f org-dispatch-plan "$@"
    ;;
  retry)
    [[ $# -ge 4 ]] || { echo "usage: org-dispatch retry ID WHEN NOTE" >&2; exit 2; }
    shift
    exec flock -n "${XDG_RUNTIME_DIR:-/tmp}/org-dispatch.lock" "${batch[@]}" -f org-dispatch-retry "$@"
    ;;
  *) echo "usage: org-dispatch [run|scan|reconcile --dry-run|plan SPEC.json|finish ID STATE [NOTE] [--headline LINE]|retry ID WHEN NOTE]" >&2; exit 2 ;;
esac
