#!/usr/bin/env bash
set -euo pipefail

# Stamp and follow Org links to agent sessions running in herdr-core (hc).
#
#   herdr-link stamp [TAG]  print an Org link for the calling agent's session
#   herdr-link jump LINK    show the session's terminal, resuming the session if needed
#   herdr-link attach LINK  attach this terminal to it, resuming likewise
#   herdr-link pick         choose a live agent on this host and attach to it
#
# LINK is [herdr:]HOST/AGENT:SESSION[@WHERE]. SESSION is the Claude session ID or
# the Pi session UUID; it finds the terminal through hc's org.session label.
# WHERE records the hc terminal (t7) or old Herdr pane the link was stamped in,
# for people reading it; only the label proves where the session runs now.
# The same link works on every client: jump picks the
# Herdr app on a desktop and hc attach elsewhere, and a phone runs
# `ssh -t HOST herdr-link attach LINK`, so no client-specific target is stored.

die() {
  echo "herdr-link: $*" >&2
  exit 1
}

this_host() { cat /proc/sys/kernel/hostname; }

# The label reads AGENT@HOST/YYYY-MM-DDTHHMM, ending in #TAG as a lowercase slug
# when TAG is given. Stamping also labels this terminal with its agent and
# session, so jump, June and the dispatcher can find it again.
stamp() {
  local agent session tag
  [[ -n ${HC_TERMINAL_ID:-} ]] || die "not in an hc terminal"
  if [[ -n ${CLAUDE_CODE_SESSION_ID:-} ]]; then
    agent=claude session=$CLAUDE_CODE_SESSION_ID
  elif [[ -n ${PI_SESSION_ID:-} ]]; then
    agent=pi session=$PI_SESSION_ID
  else
    die "no agent session in this terminal"
  fi
  [[ $session =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || die "unexpected session ID $session"
  hc label "$HC_TERMINAL_ID" "org.agent=$agent" "org.session=$session" >/dev/null ||
    die "could not label $HC_TERMINAL_ID"
  tag=$(tr '[:upper:]' '[:lower:]' <<<"${1:-}" | sed -E 's/[^a-z0-9]+/-/g; s/^-|-$//g')
  printf '[[herdr:%s/%s:%s@%s][%s@%s/%s%s]]\n' "$(this_host)" "$agent" "$session" "$HC_TERMINAL_ID" \
    "$agent" "$(this_host)" "$(date +%Y-%m-%dT%H%M)" "${tag:+#$tag}"
}

parse() {
  local rest
  link=${1#herdr:}
  host=${link%%/*}
  rest=${link#*/}
  rest=${rest%@*}
  agent=${rest%%:*}
  session=${rest#*:}
  [[ $link == */* && $rest == *:* && -n $host && -n $agent && -n $session ]] || die "bad link: $1"
  [[ $agent =~ ^[a-z]+$ && $session =~ ^[0-9a-f-]+$ ]] || die "bad link: $1"
  remote=
  [[ $host == "$(this_host)" ]] || remote=1
}

# Run a command on the link's host, over ssh when it is not this one.
on_host() {
  if [[ -z $remote ]]; then
    "$@"
  else
    ssh -o ConnectTimeout=5 "$host" "$(printf '%q ' "$@")"
  fi
}

# Print the address of the live terminal running the link's session, if any.
# Only the labels count: the hint names where it ran, not where it runs now.
live_terminal() {
  on_host hc ls --json --label "org.session=$session" | jq -r '
    [.terminals[] | select(.state == "live") | .address] | if length > 1 then error("session runs in \(length) terminals") else .[0] // empty end'
}

# Find the session file on its host and set the directory and resume command.
# Claude keeps sessions in its config directory, and an account launcher such
# as claude-work fixes CLAUDE_CONFIG_DIR to ~/.claude-work. Resume through the
# launcher that owns the directory holding the session: claude-NAME for
# ~/.claude-NAME, else claude-direct (or claude) with CLAUDE_CONFIG_DIR set.
find_session() {
  local found
  found=$(on_host sh -s -- "$agent" "$session" <<'EOF'
f= run=
case $1 in
  claude)
    for d in ~/.claude ~/.claude-*; do
      f=$(ls "$d"/projects/*/"$2".jsonl 2>/dev/null | head -n1)
      [ -n "$f" ] && break
    done
    [ -n "$f" ] || exit 1
    case ${d##*/} in
      .claude-*) launcher=claude-${d##*/.claude-} ;;
      *) launcher= ;;
    esac
    if [ -n "$launcher" ] && command -v "$launcher" >/dev/null 2>&1; then run=$launcher
    elif command -v claude-direct >/dev/null 2>&1; then run="CLAUDE_CONFIG_DIR='$d' claude-direct"
    else run="CLAUDE_CONFIG_DIR='$d' claude"; fi ;;
  pi) f=$(ls ~/.local/state/pi/sessions/*/*_"$2".jsonl ~/.pi/agent/sessions/*/*_"$2".jsonl 2>/dev/null | head -n1) ;;
esac
[ -n "$f" ] || exit 1
printf '%s\n%s\n%s\n%s\n' "$(grep -m1 -o '"cwd":"[^"]*"' "$f" | cut -d'"' -f4)" "$f" \
  "$(jq -r 'select(.type == "session_info" or .type == "custom-title") | .name // .customTitle // empty' "$f" | tail -n1)" \
  "$run"
EOF
  ) || die "session $agent:$session not found on $host; it may have been deleted"
  cwd=$(sed -n 1p <<<"$found")
  name=$(sed -n 3p <<<"$found")
  case $agent in
    # Clearing CLAUDE_CODE_DISABLE_TERMINAL_TITLE lets Claude report its status to hc.
    claude) cmd="$(sed -n 4p <<<"$found") --resume $session --settings '{\"env\":{\"CLAUDE_CODE_DISABLE_TERMINAL_TITLE\":\"\"}}'" ;;
    pi) cmd="pi --session $(printf '%q' "$(sed -n 2p <<<"$found")")" ;;
  esac
}

# The herdr-app space a resumed session opens in: the one named for the task's
# project when its terminals show one, else SPACE (the shown space on a desktop),
# else none, which keeps it hidden from the app but in hc ls. org-dispatch names
# its sessions "auto · HEADING"; their project is the Org file whose Sessions
# link names this session.
space_for() {
  local fallback=${1:-} project='' address
  if [[ ${name:-} == "auto · "* ]]; then
    project=$(grep -rlF --include='*.org' --exclude='archive*' --exclude='*.sync-conflict-*' \
      ":$session@" "$HOME/org" 2>/dev/null | head -n1 || true)
    [[ -z $project ]] || project=$(basename "$project" .org)
  fi
  if [[ -n $project ]]; then
    address=$(on_host hc ls --json | jq -r --arg p "$project" '
      first(.terminals[] | select((.where // "") | ascii_downcase | sub("^\\[[0-9]+\\] "; "") | startswith(($p | ascii_downcase) + " / ")) | .address) // empty')
    if [[ -n $address ]]; then
      on_host hc get --json "$address" | jq -r '.labels["herdr.space"] // empty'
      return
    fi
  fi
  printf '%s\n' "$fallback"
}

# Start the saved session again in a new terminal of its own, labelled so this
# link finds it. It must not end with whoever ran herdr-link.
resume() {
  local space=${1:-} labels=(--label "org.agent=$agent" --label "org.session=$session")
  [[ -z $space ]] || labels+=(--label "herdr.space=$space")
  on_host hc run --json --bg --no-parent --cwd "$cwd" "${labels[@]}" -- sh -c "exec $cmd" | jq -r '.address // empty'
}

# The app window on this desktop, if one is running.
app_running() {
  [[ -z $remote && -n ${WAYLAND_DISPLAY:-} ]] && command -v herdr-app >/dev/null && herdr-app status >/dev/null 2>&1
}

raise_app() {
  if command -v hyprctl >/dev/null; then
    hyprctl dispatch 'hl.dsp.focus({ window = "class:herdr-app" })' >/dev/null 2>&1 || true
  fi
}

jump() {
  local target space
  parse "$1"
  # No desktop app here, or a session on another host: attach in a terminal.
  if [[ -n $remote || -z ${WAYLAND_DISPLAY:-} ]] || ! command -v herdr-app >/dev/null; then
    attach "$1"
  fi
  if ! app_running; then
    setsid -f herdr-app >/dev/null 2>&1
    for _ in {1..40}; do app_running && break; sleep 0.25; done
    app_running || die "the Herdr app did not start"
  fi
  target=$(live_terminal)
  if [[ -z $target ]]; then
    find_session
    target=$(resume "$(space_for "$(herdr-app status | jq -r '.space // empty')")")
    [[ -n $target ]] || die "could not resume $agent:$session"
  elif [[ -z $(hc get --json "$target" | jq -r '.labels["herdr.space"] // empty') ]]; then
    # A hidden worker: show it in the current space.
    hc label "$target" "herdr.space=$(herdr-app status | jq -r '.space // empty')" >/dev/null
  fi
  raise_app
  herdr-app 'do' agent.focus --terminal "$target" >/dev/null
}

# Attach this terminal to the session's agent, as over ssh from a phone.
# Detaching (Ctrl+\) leaves the agent running and the desktop as it was.
attach() {
  local target
  parse "$1"
  # Attaching needs a terminal on the link's host, so hand the link to it.
  [[ -z $remote ]] || exec ssh -t "$host" "$(printf '%q ' herdr-link attach "$1")"
  target=$(live_terminal)
  if [[ -z $target ]]; then
    find_session
    target=$(resume "$(space_for)")
    [[ -n $target ]] || die "could not resume $agent:$session"
  fi
  exec hc attach "$target"
}

# Choose a live agent on this host from a numbered list and attach to it.
pick() {
  local rows
  rows=$(hc ls --json | jq -r '
    .terminals[] | select(.state == "live" and ((.status // null) != null or (.agent // "") != ""))
    | select((.agent // "") | test("^(pi|claude|claude-code|codex)$"))
    | [.address, "\(.where // (.cwd | sub("^/home/[^/]+"; "~"))) · \(.agent) · \(.status // "unknown")"] | @tsv')
  [[ -n $rows ]] || die "no agents running"
  mapfile -t terminals < <(cut -f1 <<<"$rows")
  mapfile -t labels < <(cut -f2 <<<"$rows")
  PS3="agent: "
  select _choice in "${labels[@]}"; do
    [[ -n ${REPLY//[^0-9]/} && $REPLY -ge 1 && $REPLY -le ${#terminals[@]} ]] &&
      exec hc attach "${terminals[REPLY - 1]}"
  done
}

case ${1:-} in
  stamp) [[ $# -le 2 ]] || die "usage: herdr-link stamp [TAG]"; stamp "${2:-}" ;;
  jump) [[ $# -eq 2 ]] || die "usage: herdr-link jump LINK"; jump "$2" ;;
  attach) [[ $# -eq 2 ]] || die "usage: herdr-link attach LINK"; attach "$2" ;;
  pick) pick ;;
  *) die "usage: herdr-link stamp [TAG] | herdr-link jump LINK | herdr-link attach LINK | herdr-link pick" ;;
esac
