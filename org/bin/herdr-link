#!/usr/bin/env bash
set -euo pipefail

# Stamp and follow Org links to Herdr agent sessions.
#
#   herdr-link stamp [TAG]  print an Org link for the calling Herdr pane
#   herdr-link jump LINK    focus the pane for LINK, resuming the session if needed
#   herdr-link attach LINK  attach this terminal to that pane, resuming likewise
#   herdr-link pick         choose a live agent on this host and attach to it
#
# LINK is [herdr:]HOST/AGENT:SESSION[@PANE]. SESSION is the Claude session ID or
# the Pi session UUID. PANE is only a fallback hint; the session finds the pane.

die() {
  echo "herdr-link: $*" >&2
  exit 1
}

# The label reads AGENT@HOST/YYYY-MM-DDTHHMM, ending in #TAG as a lowercase slug
# when TAG is given.
stamp() {
  [[ -n ${HERDR_PANE_ID:-} ]] || die "not in a Herdr pane"
  herdr pane get "$HERDR_PANE_ID" | jq -er --arg host "$(</proc/sys/kernel/hostname)" --arg tag "${1:-}" '
    .result.pane as $p
    | ($p.agent_session // error("no agent session in this pane")) as $s
    | ($s.value | if $s.agent == "pi" then capture("_(?<id>[0-9a-f-]{36})\\.jsonl$").id else . end) as $id
    | ($tag | ascii_downcase | gsub("[^a-z0-9]+"; "-") | gsub("^-|-$"; "") | if . == "" then "" else "#" + . end) as $tag
    | "[[herdr:\($host)/\($s.agent):\($id)@\($p.pane_id)][\($s.agent)@\($host)/\(now | strflocaltime("%Y-%m-%dT%H%M"))\($tag)]]"'
}

# Run a command on the link's host, over ssh when it is not this one.
on_host() {
  if [[ -z $remote ]]; then
    "$@"
  else
    ssh -o ConnectTimeout=5 "$host" "$(printf '%q ' "$@")"
  fi
}

# Find the session file on its host and set the directory and resume command.
find_session() {
  local found
  found=$(on_host sh -s -- "$agent" "$session" <<'EOF'
case $1 in
  claude) f=$(ls ~/.claude/projects/*/"$2".jsonl 2>/dev/null | head -n1) ;;
  pi) f=$(ls ~/.local/state/pi/sessions/*/*_"$2".jsonl ~/.pi/agent/sessions/*/*_"$2".jsonl 2>/dev/null | head -n1) ;;
esac
[ -n "$f" ] || exit 1
printf '%s\n%s\n%s\n' "$(grep -m1 -o '"cwd":"[^"]*"' "$f" | cut -d'"' -f4)" "$f" \
  "$(grep '"type":"session_info"' "$f" | tail -n1 | grep -o '"name":"[^"]*"' | cut -d'"' -f4)"
EOF
  ) || die "session $agent:$session not found on $host"
  cwd=$(sed -n 1p <<<"$found")
  name=$(sed -n 3p <<<"$found")
  case $agent in
    claude) cmd="claude --resume $session" ;;
    pi) cmd="pi --session $(sed -n 2p <<<"$found")" ;;
  esac
}

# Open a focused tab in DIR and print its pane. org-dispatch names its pi
# sessions "auto · HEADING" and opens them in the workspace named for the task's
# Org file, its project; a reopened run goes back there under the same tab label.
# The Org file is the one whose Sessions link names this session.
open_tab() {
  local dir=$1 label project= workspace created
  if [[ $name == "auto · "* ]]; then
    project=$(grep -rlF --include='*.org' --exclude='archive*' --exclude='*.sync-conflict-*' \
      ":$session@" "$HOME/org" 2>/dev/null | head -n1 || true)
    [[ -z $project ]] || project=$(basename "$project" .org)
  fi
  if [[ -z $project ]]; then
    on_host herdr tab create --cwd "$dir" --focus | jq -r .result.root_pane.pane_id
    return
  fi
  label=${name#auto · }
  label=${label:0:40}
  workspace=$(on_host herdr workspace list | jq -r --arg project "$project" '
    first(.result.workspaces[] | select(.label | ascii_downcase | sub("^\\[[0-9]+\\] "; "") == ($project | ascii_downcase)) | .workspace_id) // empty')
  if [[ -n $workspace ]]; then
    on_host herdr tab create --workspace "$workspace" --cwd "$dir" --label "$label" --focus |
      jq -r .result.root_pane.pane_id
  else
    created=$(on_host herdr workspace create --cwd "$dir" --label "$project" --focus)
    on_host herdr tab rename "$(jq -r .result.root_pane.tab_id <<<"$created")" "$label" >/dev/null
    jq -r .result.root_pane.pane_id <<<"$created"
  fi
}

# Raise the window running a Herdr client for this host. Fails if none exists.
raise() {
  local pattern clients pid p window address workspace
  if [[ -z $remote ]]; then
    pattern='[^ ]*/?herdr( --session [^ ]+)?$'
  else
    pattern="[^ ]*/?herdr --remote $host( |$)"
  fi
  clients=$(hyprctl clients -j | jq -r '.[] | [.pid, .address, .workspace.name] | @tsv')
  for pid in $(ps -eo pid=,args= | sed -E 's/^ *//' | grep -E "^[0-9]+ ($pattern)" | cut -d' ' -f1); do
    p=$pid
    while [[ $p -gt 1 ]]; do
      window=$(awk -F'\t' -v p="$p" '$1 == p { print; exit }' <<<"$clients")
      if [[ -n $window ]]; then
        IFS=$'\t' read -r _ address workspace <<<"$window"
        hyprctl dispatch "hl.dsp.focus({ workspace = \"$workspace\" })" >/dev/null
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
        return 0
      fi
      p=$(ps -o ppid= -p "$p" | tr -d ' ')
    done
  done
  return 1
}

# Herdr sends focus commands to the client whose window was focused last, so
# raise or open that window before focusing anything.
show() {
  local launch=(herdr) i
  [[ -z $remote ]] || launch=(herdr --remote "$host" --remote-keybindings server)
  if ! raise; then
    # Clear Herdr's variables so a launch from inside a pane is not nested.
    setsid -f env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID \
      kitty --class=Herdr "${launch[@]}" >/dev/null 2>&1
    for i in {1..20}; do
      sleep 0.25
      raise && break
    done
    ((i < 20)) || die "no Herdr client window for $host"
    sleep 1
  fi
  sleep 0.3
}

parse() {
  local rest
  link=${1#herdr:}
  pane=
  host=${link%%/*}
  rest=${link#*/}
  if [[ $rest == *@* ]]; then
    pane=${rest##*@}
    rest=${rest%@*}
  fi
  agent=${rest%%:*}
  session=${rest#*:}
  [[ $link == */* && $rest == *:* && -n $host && -n $agent && -n $session ]] || die "bad link: $1"
  remote=
  [[ $host == "$(</proc/sys/kernel/hostname)" ]] || remote=1
}

# Print the pane running the link's session, if any.
live_pane() {
  on_host herdr agent list | jq -r --arg a "$agent" --arg s "$session" '
    first(.result.agents[] | select(.agent_session.agent == $a and (.agent_session.value | contains($s))) | .pane_id) // empty'
}

jump() {
  local link target tab new cwd cmd name=
  parse "$1"
  target=$(live_pane)
  if [[ -z $target && -n $pane ]]; then
    tab=$(on_host herdr pane get "$pane" 2>/dev/null | jq -r '.result.pane.tab_id // empty') || true
  fi
  [[ -n $target || -n ${tab:-} ]] || find_session

  show
  if [[ -n $target ]]; then
    on_host herdr agent focus "$target" >/dev/null
  elif [[ -n ${tab:-} ]]; then
    on_host herdr tab focus "$tab" >/dev/null
  else
    new=$(open_tab "$cwd")
    on_host herdr pane run "$new" "$cmd" >/dev/null
  fi
}

# Attach this terminal to one agent pane, as over ssh from a phone. Detaching
# leaves the agent running and the desktop layout as it was. Herdr allows one
# attached client per pane, so this one takes over from any stale earlier one.
attach_pane() {
  exec env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID \
    herdr agent attach "$1" --takeover
}

attach() {
  local link target new cwd cmd name=
  parse "$1"
  # Attaching needs a terminal on the link's host, so hand the link to it.
  [[ -z $remote ]] || exec ssh -t "$host" "$(printf '%q ' herdr-link attach "$1")"
  target=$(live_pane)
  if [[ -z $target ]]; then
    find_session
    new=$(open_tab "$cwd")
    herdr pane run "$new" "$cmd" >/dev/null
    # Herdr attaches only to a pane it has detected an agent in.
    for _ in {1..40}; do
      target=$(live_pane)
      [[ -z $target ]] || break
      sleep 0.25
    done
    [[ -n $target ]] || die "resumed $agent:$session in $new but Herdr has not detected it"
  fi
  attach_pane "$target"
}

# Choose a live agent on this host from a numbered list and attach to it.
pick() {
  local rows
  rows=$(jq -rn --argjson ws "$(herdr workspace list)" --argjson tabs "$(herdr tab list)" \
    --argjson agents "$(herdr agent list)" '
    def bare: sub("^\\[[0-9]+\\] "; "");
    ($ws.result.workspaces | map({key: .workspace_id, value: (.label | bare)}) | from_entries) as $w
    | ($tabs.result.tabs | map({key: .tab_id, value: (.label | bare)}) | from_entries) as $t
    | $agents.result.agents[]
    | [.pane_id, "\($w[.workspace_id]) / \($t[.tab_id]) · \(.agent) · \(.agent_status) · \(.cwd | sub("^/home/[^/]+"; "~"))"]
    | @tsv')
  [[ -n $rows ]] || die "no agents running"
  mapfile -t panes < <(cut -f1 <<<"$rows")
  mapfile -t labels < <(cut -f2 <<<"$rows")
  PS3="agent: "
  select _choice in "${labels[@]}"; do
    [[ -n ${REPLY//[^0-9]/} && $REPLY -ge 1 && $REPLY -le ${#panes[@]} ]] &&
      attach_pane "${panes[REPLY - 1]}"
  done
}

case ${1:-} in
  stamp) [[ $# -le 2 ]] || die "usage: herdr-link stamp [TAG]"; stamp "${2:-}" ;;
  jump) [[ $# -eq 2 ]] || die "usage: herdr-link jump LINK"; jump "$2" ;;
  attach) [[ $# -eq 2 ]] || die "usage: herdr-link attach LINK"; attach "$2" ;;
  pick) pick ;;
  *) die "usage: herdr-link stamp [TAG] | herdr-link jump LINK | herdr-link attach LINK | herdr-link pick" ;;
esac
