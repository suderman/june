;;; dependencies.el --- Dependency and plan fixtures -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)

(defvar dep-files nil)
(defvar dep-notices nil)

(defmacro dep-fixture (&rest body)
  `(let* ((tree (make-temp-file "org-dispatch-dependencies-" t))
          (org-dispatch-root (expand-file-name "org/work" tree))
          (org-dispatch-state-dir (expand-file-name "state" tree))
          (org-dispatch-settle 0)
          (org-dispatch-max-agents 5)
          (dep-files nil) (dep-notices nil))
     (unwind-protect
         (cl-letf (((symbol-function 'org-dispatch--agenda-files) (lambda () dep-files))
                   ((symbol-function 'org-dispatch--notify)
                    (lambda (title body) (push (list title body) dep-notices)))
                   ((symbol-function 'org-dispatch--herdr)
                    (lambda (&rest _) (error "Unexpected Herdr call"))))
           (make-directory org-dispatch-root t)
           ,@body)
       (delete-directory tree t))))

(defun dep-write (name text &optional archived)
  (let ((file (expand-file-name name org-dispatch-root)))
    (make-directory (file-name-directory file) t)
    (with-temp-file file (insert text))
    (unless archived (cl-pushnew file dep-files :test #'equal))
    file))

(defun dep-task (id state &optional refs)
  (dep-write (concat id "/" id ".org")
             (format "* %s %s\n:PROPERTIES:\n:ID: %s\n:HOST: kit\n:DEPENDS: %s\n:END:\n"
                     state id id (string-join refs " "))))

(defun dep-get (id)
  (org-dispatch--edit (org-dispatch--find id dep-files) id #'org-dispatch--task))

(defun dep-result (id)
  (org-dispatch--dependencies (dep-get id)))

(ert-deftest dependencies-require-done-and-all-edges ()
  (dep-fixture
   (dep-task "child" "AUTO" '("id:root" "id:other"))
   (dep-task "other" "DONE")
   (dolist (state '("TODO" "AUTO" "PROG" "EVAL" "HOLD" "DONE"))
     (dep-task "root" state)
     (should (eq (plist-get (dep-result "child") :kind)
                 (pcase state ("DONE" 'ready) ("HOLD" 'blocked) (_ 'waiting)))))
   (dep-task "other" "EVAL")
   (should (eq (plist-get (dep-result "child") :kind) 'waiting))
   (should (string-search "other (EVAL)" (plist-get (dep-result "child") :reason)))))

(ert-deftest dependencies-report-root-blockers-and-cycles ()
  (dep-fixture
   (dep-task "child" "AUTO" '("id:waiting" "id:middle"))
   (dep-task "waiting" "PROG")
   (dep-task "middle" "AUTO" '("id:root"))
   (dep-task "root" "HOLD")
   (should (equal (plist-get (dep-result "child") :reason) "root (HOLD)"))
   (dep-task "root" "AUTO" '("id:middle"))
   (should (string-prefix-p "cycle at" (plist-get (dep-result "child") :reason)))
   (dep-task "root" "AUTO" '("id:root"))
   (should (string-prefix-p "cycle at" (plist-get (dep-result "root") :reason)))
   (dep-task "root" "AUTO" '("id:absent"))
   (should (equal (plist-get (dep-result "child") :reason) "missing ID absent"))
   (dep-task "root" "AUTO" '("garbage"))
   (should (string-prefix-p "invalid DEPENDS" (plist-get (dep-result "child") :reason)))
   (dep-write "duplicate.org" "* DONE Duplicate\n:PROPERTIES:\n:ID: middle\n:END:\n")
   (should (equal (plist-get (dep-result "child") :reason) "duplicate ID middle"))))

(ert-deftest dependencies-find-archives-but-never-launch-them ()
  (dep-fixture
   (dep-task "child" "AUTO" '("id:archived" "id:older"))
   (let ((archive (dep-write "child/archive.org" "* DONE Archived\n:PROPERTIES:\n:ID: archived\n:END:\n" t))
         (older (dep-write "../archive/2025/old.org" "* DONE Older\n:PROPERTIES:\n:ID: older\n:END:\n" t)))
     (should (equal (org-dispatch--find "archived" dep-files) archive))
     (should (equal (org-dispatch--find "older" dep-files) older))
     (should (eq (plist-get (dep-result "child") :kind) 'ready))
     (dep-write "child/archive.org" "* AUTO Archived\n:PROPERTIES:\n:ID: archived\n:END:\n" t)
     (should-not (org-dispatch--files (list archive)))
     (should-not (org-dispatch--files (list older))))))

(ert-deftest dependencies-cost-no-slot-and-notify-once-per-blocker ()
  (dep-fixture
   (dep-task "child" "AUTO" '("id:root"))
   (dep-task "root" "HOLD")
   ;; An independent task in the same directory must not be starved by a wait.
   (let* ((child (dep-get "child"))
          (free (list :id "free" :heading "free" :host "kit" :agent "pi"
                      :hash "free" :dir (plist-get child :dir) :june t))
          (org-dispatch-max-agents 1))
     (should (= 2 (length (org-dispatch--eligible (list child free) nil t))))
     (should-not dep-notices)
     (dotimes (_ 2)
       (should (equal (mapcar (lambda (task) (plist-get task :id))
                             (org-dispatch--eligible (list child free) nil)) '("free"))))
     (should (= 1 (length dep-notices)))
     ;; A body edit and a new process's pending state do not repeat the notice.
     (let ((child (plist-put (dep-get "child") :hash "edited")))
       (org-dispatch--eligible (list child) nil))
     (should (= 1 (length dep-notices)))
     (dep-task "root" "EVAL")
     (org-dispatch--eligible (list (dep-get "child")) nil)
     (dep-task "root" "HOLD")
     (org-dispatch--eligible (list (dep-get "child")) nil)
     (should (= 2 (length dep-notices)))
     (dep-task "root" "DONE")
     (should (equal (mapcar (lambda (task) (plist-get task :id))
                           (org-dispatch--eligible (list (dep-get "child")) nil)) '("child")))
     (should (equal (plist-get (dep-get "child") :todo) "AUTO")))))

(ert-deftest dependencies-recheck-before-launch-and-preserve-schedules ()
  (dep-fixture
   (dep-task "root" "DONE")
   (let ((file (dep-task "child" "AUTO" '("id:root"))))
     (let ((snapshot (dep-get "child")))
       (dep-task "root" "EVAL")
       (should-not (org-dispatch--launch snapshot))
       (should-not (file-exists-p org-dispatch-state-dir))
       (dep-task "root" "DONE")
       (org-dispatch--edit file "child" (lambda () (org-todo "HOLD")))
       (should-not (org-dispatch--launch snapshot)))
     (dep-task "child" "AUTO" '("id:root"))
     (org-dispatch--edit file "child" (lambda () (org-entry-put nil "SCHEDULED" "<2999-01-01 Tue>")))
     (should-not (org-dispatch--eligible (list (dep-get "child")) nil t)))))

(ert-deftest dependencies-handoff-keeps-finish-note-and-outcome ()
  (dep-fixture
   (let ((file (dep-task "root" "PROG")))
     (org-dispatch--edit file "root"
                         (lambda ()
                           (org-entry-put nil "REVIEW" "no")
                           (org-dispatch--append "Outcome" "Verified with fixture checks.")))
     (let ((command-line-args-left '("root" "DONE" "All checks passed.")))
       (org-dispatch-finish))
     (dep-task "child" "AUTO" '("id:root"))
     (let ((prompt (org-dispatch--render "task" (dep-get "child"))))
       (should (string-search "*** root" prompt))
       (should (string-search file prompt))
       (should (string-search "State: DONE" prompt))
       (should (string-search "All checks passed." prompt))
       (should (string-search "Verified with fixture checks." prompt))
       (should-not (string-search "{{DEPENDENCIES}}" prompt)))
     (org-dispatch--claim (dep-get "root") "p-fixture" nil)
     (org-dispatch--edit file "root"
                         (lambda () (should-not (org-entry-get nil "DISPATCH_FINISH")))))))

(defun dep-spec ()
  (copy-tree '((key . "test-plan") (title . "Launch plan") (file . "work/a/a.org")
    (tasks . (((key . "first") (title . "Build it") (file . "work/a/a.org")
               (body . "Build and verify it."))
              ((key . "second") (title . "Use it") (file . "work/b/b.org")
               (body . "Use the verified build.") (depends . ("first"))))))))

(defun dep-plan-files ()
  (dep-write "a/a.org" "#+TITLE: A\n\n* TODO Existing task\nKeep this.\n")
  (dep-write "b/b.org" "#+TITLE: B\n"))

(ert-deftest plan-queues-across-files-and-replays-without-resetting-tasks ()
  (dep-fixture
   (dep-plan-files)
   (let* ((spec (dep-spec))
          (result (org-dispatch--queue-plan spec))
          (first (plist-get (car result) :id))
          (second (plist-get (cadr result) :id)))
     (should (equal (plist-get (dep-get second) :depends) (list (concat "id:" first))))
     (should (plist-get (dep-get second) :review))
     (should (plist-get (dep-get first) :june))
     (should (eq (plist-get (dep-result second) :kind) 'waiting))
     (org-dispatch--edit (plist-get (car result) :file) first (lambda () (org-todo "DONE")))
     (should (eq (plist-get (dep-result second) :kind) 'ready))
     (should (equal result (org-dispatch--queue-plan spec)))
     (should (equal (plist-get (dep-get first) :todo) "DONE"))
     (dolist (file dep-files)
       (with-temp-buffer
         (insert-file-contents file)
         (should-not (string-suffix-p "\n\n" (buffer-string)))))
     (with-temp-buffer
       (insert-file-contents (plist-get (car result) :file))
       (should (= 1 (how-many "^\\* Launch plan$" (point-min) (point-max))))
       (should (= 1 (how-many "^\\* DONE Build it$" (point-min) (point-max))))
       (should (string-search "Keep this." (buffer-string))))
     (let* ((text (org-dispatch--edit
                   (plist-get (car result) :file) first
                   (lambda ()
                     (prog1 (org-dispatch--subtree-text)
                       (delete-region (point) (save-excursion (org-end-of-subtree t t) (point)))))))
            (archive (dep-write "a/archive.org" text t))
            (replayed (org-dispatch--queue-plan spec)))
       (should (equal archive (plist-get (car replayed) :file)))
       (should (equal (plist-get (dep-get first) :todo) "DONE"))
       (should (= 1 (length (org-dispatch--tasks)))))
     (setf (alist-get 'title spec) "Changed plan")
     (should-error (org-dispatch--queue-plan spec)))))

(ert-deftest plan-rejects-bad-input-before-any-task-is-published ()
  (dep-fixture
   (dep-plan-files)
   (dolist (change '(missing cycle injection whitespace host readonly conflict))
     (let* ((spec (dep-spec)) (tasks (alist-get 'tasks spec)))
       (pcase change
         ('missing (setf (alist-get 'depends (car tasks)) '("id:absent")))
         ('cycle (setf (alist-get 'depends (car tasks)) '("second")))
         ('injection (setf (alist-get 'body (car tasks)) "Fine\n*\tAUTO Injected"))
         ('whitespace (setf (alist-get 'title (car tasks)) "  AUTO Injected  "))
         ('host (setf (alist-get 'host (car tasks)) "mars"))
         ('readonly (set-file-modes (car dep-files) #o444))
         ('conflict (dep-write "a/a.sync-conflict-test.org" "Conflict" t)))
       (let ((message (condition-case err (org-dispatch--queue-plan spec)
                        (error (error-message-string err)))))
         (should (stringp message))
         (should (string-match-p
                  (pcase change
                    ('missing "Missing dependency ID") ('cycle "Dependency cycle")
                    ('injection "Task body") ('whitespace "Title must not carry")
                    ('host "Unknown host") ('readonly "Not a writable agenda file")
                    ('conflict "Resolve Syncthing conflict")) message)))
       (when (eq change 'readonly) (set-file-modes (car dep-files) #o644))
       (dolist (file dep-files)
         (with-temp-buffer
           (insert-file-contents file)
           (should-not (string-search "* AUTO" (buffer-string)))))))))

(ert-deftest plan-recovers-after-a-partial-publish ()
  (dep-fixture
   (dep-plan-files)
   (let ((real-rename (symbol-function 'rename-file)) (count 0) (spec (dep-spec)))
     (cl-letf (((symbol-function 'rename-file)
                (lambda (&rest args)
                  (when (= (cl-incf count) 2) (error "Fixture publish interruption"))
                  (apply real-rename args))))
       (should-error (org-dispatch--queue-plan spec)))
     (should (= 1 (length (org-dispatch--tasks))))
     (let ((result (org-dispatch--queue-plan spec)))
       (should (= 2 (length (org-dispatch--tasks))))
       (should (equal result (org-dispatch--queue-plan spec)))))))

(ert-deftest plan-accepts-archived-external-ids-and-keeps-retry-budget ()
  (dep-fixture
   (dep-plan-files)
   (dep-write "a/archive.org" "* DONE Accepted\n:PROPERTIES:\n:ID: accepted\n:END:\n" t)
   (let* ((spec (dep-spec)) (task (car (alist-get 'tasks spec))))
     (setf (alist-get 'depends task) '("id:accepted"))
     (let* ((result (org-dispatch--queue-plan spec))
            (second (plist-get (cadr result) :id)))
       (should (eq (plist-get (dep-result (plist-get (car result) :id)) :kind) 'ready))
       (org-dispatch--edit (plist-get (cadr result) :file) second
                           (lambda ()
                             (org-entry-put nil "RETRY" "7")
                             (org-entry-put nil "DEPENDS_ON_STATE" "EVAL")))
       (org-dispatch--edit (plist-get (car result) :file) (plist-get (car result) :id)
                           (lambda () (org-todo "EVAL")))
       (dotimes (_ 3) (should-not (org-dispatch--eligible (list (dep-get second)) nil)))
       (should (= 7 (plist-get (dep-get second) :retry)))))))

(ert-deftest plan-refuses-a-concurrent-edit-without-overwriting-it ()
  (dep-fixture
   (dep-plan-files)
   (let ((real-modes (symbol-function 'set-file-modes)) (edited nil))
     (cl-letf (((symbol-function 'set-file-modes)
                (lambda (&rest args)
                  (unless edited
                    (setq edited t)
                    (dep-write "b/b.org" "#+TITLE: B\n\nJon's concurrent edit.\n"))
                  (apply real-modes args))))
       (should-error (org-dispatch--queue-plan (dep-spec))))
     (with-temp-buffer
       (insert-file-contents (expand-file-name "b/b.org" org-dispatch-root))
       (should (string-search "Jon's concurrent edit." (buffer-string))))
     (should (= 2 (length (org-dispatch--queue-plan (dep-spec))))))))

(ert-deftest plan-command-parses-json-and-never-launches-work ()
  (dep-fixture
   (dep-plan-files)
   (let* ((path (expand-file-name "spec.json" (file-name-directory org-dispatch-root)))
          (json "{\"key\":\"json-plan\",\"title\":\"Queue example\",\"file\":\"work/a/a.org\",\"tasks\":[{\"key\":\"one\",\"title\":\"Check it\",\"file\":\"work/b/b.org\",\"body\":\"Verify the result.\",\"review\":false,\"depends\":[]}]}")
          (command-line-args-left (list path)))
     (with-temp-file path (insert json))
     (let* ((output (with-output-to-string (org-dispatch-plan)))
            (result (json-parse-string output :array-type 'list :object-type 'plist)))
       (should (= 1 (length result)))
       (should-not (plist-get (dep-get (plist-get (car result) :id)) :review)))
     (should-not (file-exists-p org-dispatch-state-dir))
     (let ((spec (dep-spec)))
       (setf (alist-get 'title spec) "AUTO Bad table")
       (should-error (org-dispatch--queue-plan spec))))))

(ert-run-tests-batch-and-exit)
