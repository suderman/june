#!/usr/bin/env bash
set -euo pipefail

# Batch tests for org-edit against fixture Org files. Needs only emacs.

org="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
fixture="$(mktemp -d)"
trap 'rm -rf -- "$fixture"' EXIT
export HOME="$fixture/home"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$fixture/state"
export XDG_RUNTIME_DIR="$fixture/runtime"
mkdir -p "$XDG_RUNTIME_DIR"
# The date checks compare against Calgary time, which needs zone data; NixOS keeps it in /etc/zoneinfo.
if [[ -z ${TZDIR:-} && ! -d /usr/share/zoneinfo && -d /etc/zoneinfo ]]; then export TZDIR=/etc/zoneinfo; fi
unset JUNE_CONFIG_DIR
mkdir -p "$HOME/org"

edit="$org/edit/org-edit"
failures=0

check() {
  local name=$1
  shift
  if "$@"; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    failures=$((failures + 1))
  fi
}

run() { bash "$edit" "$@" 2>&1 || true; }
has() { grep -q -- "$2" <<<"$1"; }
line() { grep -q -- "$2" "$1"; }
lacks_line() { ! grep -q -- "$2" "$1"; }

tasks="$HOME/org/tasks.org"
cat >"$tasks" <<'EOF'
* TODO Fix the thing :kit:
* TODO [#A] Water plants
SCHEDULED: <2026-10-01 Thu +1w>
* TODO Twin
* TODO Twin
:PROPERTIES:
:ID:       twin-two
:END:
* HOLD Plan
EOF

out=$(run todo "$tasks" "Fix the thing" prog)
check "todo sets a state by title" line "$tasks" '^\* PROG Fix the thing :kit:$'
check "todo prints the heading" has "$out" 'PROG Fix the thing'

sed -i 's/^\* PROG Fix the thing :kit:$/* PROG Fix the thing :kit:auto:/' "$tasks"
run todo "$tasks" "Fix the thing" DONE >/dev/null
check "DONE writes CLOSED" line "$tasks" '^CLOSED: \[20'
check "leaving PROG drops :auto:" line "$tasks" '^\* DONE Fix the thing :kit:$'

run todo "$tasks" "Water plants" DONE >/dev/null
check "DONE on a repeater advances it" line "$tasks" 'SCHEDULED: <2026-10-08 Thu +1w>'
check "the repeater stays TODO" line "$tasks" '^\* TODO \[#A\] Water plants$'
check "the repeat is logged" line "$tasks" '^- State "DONE"       from "TODO"'

run todo "$tasks" "Plan" AUTO --expect HOLD >/dev/null
check "AUTO is available to Jon and June" line "$tasks" '^\* AUTO Plan$'
out=$(run todo "$tasks" "Plan" PROG --expect HOLD)
check "a stale expected state is refused" has "$out" 'expected HOLD, found AUTO'
check "a stale request leaves state alone" line "$tasks" '^\* AUTO Plan$'
run todo "$tasks" "Plan" HOLD --expect AUTO >/dev/null
out=$(run todo "$tasks" "Plan" WAIT)
check "an unknown state is refused" has "$out" 'STATE is one of'
check "refusals leave the file" line "$tasks" '^\* HOLD Plan$'

headlines="$HOME/org/headlines.org"
cat >"$headlines" <<'EOF'
* PROG Manual work
:PROPERTIES:
:REVIEW: yes
:DEPLOY: no
:END:

** Outcome
Checked the docs against the source. They match.
EOF
for state in EVAL DONE HOLD; do
  out=$(run todo "$headlines" "Manual work" "$state" --headline "I checked it.  Docs match!")
  check "manual $state saves the state and exact headline" line "$headlines" '^:HEADLINE: *I checked it\.  Docs match!$'
  check "manual $state binds its headline to that state" line "$headlines" "^:HEADLINE_STATE: *$state$"
  check "manual $state stamps the report" line "$headlines" '^:HEADLINE_AT: *[0-9][0-9]*\.[0-9][0-9]*$'
  check "manual $state prints the resulting heading" has "$out" "^\* $state Manual work$"
done
check "manual headlines leave review policy alone" line "$headlines" '^:REVIEW: *yes$'
check "manual headlines leave deploy policy alone" line "$headlines" '^:DEPLOY: *no$'
check "manual headlines need no dispatch metadata or ID" lacks_line "$headlines" '^:\(DISPATCH_[^:]*\|JUNE_REQUEST\|HOST\|ID\):'
before=$(<"$headlines")
out=$(run todo "$headlines" "Manual work" EVAL --expect PROG --headline "New line.")
check "a stale finish refuses before replacing the headline" has "$out" 'expected PROG, found HOLD'
check "a stale finish leaves the entire task alone" test "$before" = "$(<"$headlines")"
for bad in '' ' padded' 'padded ' $'two\nlines' $'two\rlines'; do
  out=$(run todo "$headlines" "Manual work" EVAL --headline "$bad")
  check "manual finish rejects an invalid headline" has "$out" 'headline'
  check "invalid headline changes neither task nor report" test "$before" = "$(<"$headlines")"
done
out=$(run todo "$headlines" "Manual work" EVAL --headline)
check "manual finish rejects a missing headline value" has "$out" 'missing value for --headline'
out=$(run todo "$headlines" "Manual work" AUTO --headline "Not a finish.")
check "headlines cannot accompany AUTO or grant autonomy" has "$out" '--headline is only for EVAL, DONE, or HOLD'
check "a refused headline leaves the task unchanged" test "$before" = "$(<"$headlines")"
run todo "$headlines" "Manual work" HOLD >/dev/null
check "a trivial same-state finish without a headline clears old report data" lacks_line "$headlines" '^:HEADLINE'

repeat_headline="$HOME/org/repeat-headline.org"
printf '* PROG Recheck\nSCHEDULED: <2026-10-14 Wed +1d>\n:PROPERTIES:\n:REPEAT_TO_STATE: AUTO\n:END:\n' >"$repeat_headline"
run todo "$repeat_headline" Recheck DONE --headline "Checked again. Nothing changed!" >/dev/null
check "manual repeat keeps Org's AUTO behavior" line "$repeat_headline" '^\* AUTO Recheck$'
check "manual repeat binds the headline to DONE, never AUTO" line "$repeat_headline" '^:HEADLINE_STATE: *DONE$'

resume="$HOME/org/resume.org"
cat >"$resume" <<'EOF'
#+FILETAGS: :cog:
* HOLD Answer the question :cog:work:
SCHEDULED: <2026-11-03 Tue>
:PROPERTIES:
:ID:       12345678-abcd-abcd-abcd-123456789abc
:DIR:      /keep/this
:REVIEW:   no
:DEPLOY:   yes
:HEADLINE: Old question.
:HEADLINE_STATE: HOLD
:HEADLINE_AT: 1
:END:
Original scope.

** Dialog
- Agent [2026-10-25 Sun 20:00]: Which option?
EOF
out=$(run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' AUTO --expect HOLD --request inst:1 --host kit --note 'Jon chose option A. Resume.')
check "resume returns the original ID" has "$out" '"id":"12345678-abcd-abcd-abcd-123456789abc"'
check "resume reports one write" has "$out" '"written":true'
check "resume leaves the tags as they were" line "$resume" '^\* AUTO Answer the question :cog:work:$'
check "resume puts the host in the drawer" line "$resume" '^:HOST: *kit$'
check "resume fills a missing agent with the default" line "$resume" '^:AGENT: *pi$'
check "resume keeps the schedule" line "$resume" '^SCHEDULED: <2026-11-03 Tue>$'
check "resume keeps DIR" line "$resume" '^:DIR: */keep/this$'
check "resume keeps the scope" line "$resume" '^Original scope\.$'
check "resume keeps the question" line "$resume" '^- Agent .*Which option?'
check "resume records Jon answer through June" line "$resume" '^- June .*Jon chose option A. Resume\.$'
check "resume enables review" line "$resume" '^:REVIEW: *yes$'
check "resume disables deploy" line "$resume" '^:DEPLOY: *no$'
check "resume marks the request for immediate dispatch" line "$resume" '^:JUNE_REQUEST: *inst:1$'
check "resume clears the previous report" lacks_line "$resume" '^:HEADLINE'
run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' EVAL --headline "New pass checked, ready for review!" >/dev/null
before=$(<"$resume")
out=$(run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' AUTO --expect HOLD --request inst:1 --host kit --note 'Jon chose option A. Resume.')
check "replay reports no write after completion" has "$out" '"written":false'
check "replay leaves task and Dialog unchanged" test "$before" = "$(<"$resume")"
out=$(run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' AUTO --expect HOLD --request inst:2 --host kit --note 'Jon asked again.')
check "a new stale resume is refused" has "$out" 'expected HOLD, found EVAL'
check "stale resume writes no metadata or note" test "$before" = "$(<"$resume")"
run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' AUTO --expect EVAL --request inst:2 --host kit --note 'Jon asked for another pass.' >/dev/null
check "EVAL can resume again" line "$resume" '^\* AUTO Answer the question'
run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' PROG >/dev/null
out=$(run todo "$resume" 'id:12345678-abcd-abcd-abcd-123456789abc' AUTO --expect PROG --request inst:3 --host kit --note 'Jon asked.')
check "June resume refuses PROG" has "$out" 'resuming needs'
run todo "$tasks" Plan TODO >/dev/null
out=$(run todo "$tasks" Plan AUTO --expect TODO --request inst:4 --host kit --note 'Jon asked to start Plan.')
check "TODO resume creates a missing ID" has "$out" '"id":"[0-9a-f-]*"'
check "TODO can start as AUTO" line "$tasks" '^\* AUTO Plan$'
check "a started TODO gets its host in the drawer" line "$tasks" '^:HOST: *kit$'
run todo "$tasks" Plan HOLD >/dev/null
out=$(run todo "$tasks" Plan AUTO --expect HOLD --request inst:5 --host kit --agent claude --note 'Jon asked for Claude.')
check "resume can change the agent" line "$tasks" '^:AGENT: *claude$'
run todo "$tasks" Plan HOLD >/dev/null
out=$(run todo "$tasks" Plan AUTO --expect HOLD --request inst:6 --host kit --agent cobol --note 'Jon asked.')
check "resume refuses an unknown agent" has "$out" 'unknown agent cobol'

# Dependencies added while resuming, checked across agenda files and archives.
export ORG_DISPATCH_ROOT="$HOME/org/work"
mkdir -p "$ORG_DISPATCH_ROOT/deps" "$HOME/bin"
# A failing herdr keeps the scan below away from any real server.
printf '#!/bin/sh\nexit 1\n' >"$HOME/bin/herdr"
chmod +x "$HOME/bin/herdr"
deps="$ORG_DISPATCH_ROOT/deps/deps.org"
cat >"$deps" <<'EOF2'
* TODO Align panels
:PROPERTIES:
:ID:       align-1
:END:
* TODO Settled poses
SCHEDULED: <2026-11-10 Tue>
:PROPERTIES:
:ID:       poses-1
:DEPENDS:  id:archived-1
:END:
Keep this scope.
* HOLD Upstream
:PROPERTIES:
:ID:       up-1
:DEPENDS:  id:poses-1
:END:
* TODO First twin
:PROPERTIES:
:ID:       dup-1
:END:
* TODO Second twin
:PROPERTIES:
:ID:       dup-1
:END:
* TODO No ID yet
EOF2
cat >"$ORG_DISPATCH_ROOT/deps/archive.org" <<'EOF2'
* DONE Old groundwork
:PROPERTIES:
:ID:       archived-1
:END:
EOF2
resume_deps() { run todo "$deps" "$1" AUTO --expect "$2" --request "$3" --host kit --note 'Jon asked.' "${@:4}"; }
before=$(<"$deps")
out=$(resume_deps id:poses-1 TODO deps:1 --depends 'id:nowhere-1')
check "a missing prerequisite is refused" has "$out" 'Missing dependency ID nowhere-1'
out=$(resume_deps id:poses-1 TODO deps:1 --depends 'id:poses-1')
check "a self dependency is refused" has "$out" 'cannot depend on itself'
out=$(resume_deps id:poses-1 TODO deps:1 --depends 'id:up-1')
check "a cycle is refused" has "$out" 'Dependency cycle at poses-1'
out=$(resume_deps id:poses-1 TODO deps:1 --depends 'id:dup-1')
check "a duplicate prerequisite ID is refused" has "$out" 'Duplicate dependency ID dup-1'
out=$(resume_deps id:poses-1 TODO deps:1 --depends 'align-1')
check "a bare UUID is refused" has "$out" 'takes id:UUID references'
out=$(resume_deps id:poses-1 EVAL deps:1 --depends 'id:align-1')
check "a stale state with dependencies is refused" has "$out" 'expected EVAL, found TODO'
out=$(run todo "$deps" id:poses-1 AUTO --depends 'id:align-1')
check "dependencies need a full resume" has "$out" 'resuming needs'
out=$(run todo "$deps" id:poses-1 HOLD --depends 'id:align-1')
check "dependencies never ride on another state change" has "$out" 'resuming needs'
check "every refusal leaves the file unchanged" test "$before" = "$(<"$deps")"

out=$(resume_deps id:poses-1 TODO deps:1 --agent claude --depends 'id:align-1 id:archived-1')
check "resume with dependencies reports both" has "$out" '"depends":\["id:archived-1","id:align-1"\]'
check "resume with dependencies keeps the ID" has "$out" '"id":"poses-1"'
check "existing and new prerequisites merge without repeats" line "$deps" '^:DEPENDS: *id:archived-1 id:align-1$'
check "the dependent is AUTO in the same save" line "$deps" '^\* AUTO Settled poses$'
check "the dependent keeps its schedule" line "$deps" '^SCHEDULED: <2026-11-10 Tue>$'
check "the dependent keeps its scope" line "$deps" '^Keep this scope\.$'
check "the dependent gets the requested agent" line "$deps" '^:AGENT: *claude$'
check "no heading is added" test "$(grep -c '^\* ' "$deps")" = 6
check "the prerequisite is untouched" test "$(sed -n 1,4p "$deps")" = "$(sed -n 1,4p <<<"$before")"
after=$(<"$deps")
out=$(resume_deps id:poses-1 TODO deps:1 --agent claude --depends 'id:align-1 id:archived-1')
check "a replay writes nothing" has "$out" '"written":false'
check "a replay leaves the file alone" test "$after" = "$(<"$deps")"
scan=$(ORG_DISPATCH_HOST=kit ORG_DISPATCH_SETTLE=0 PATH="$HOME/bin:$PATH" \
  bash "$org/dispatch/org-dispatch" scan 2>/dev/null || true)
check "the dispatcher waits instead of launching" has "$scan" '^Settled poses	.*	waiting on Align panels (TODO)$'
out=$(resume_deps 'No ID yet' TODO deps:2 --depends 'id:align-1')
check "a task without an ID gets one and its prerequisite" line "$deps" '^:DEPENDS: *id:align-1$'
check "and reports its new ID" has "$out" '"id":"[0-9a-f-]\{36\}"'
unset ORG_DISPATCH_ROOT

out=$(run todo "$tasks" "Twin" PROG)
check "a duplicate title is refused" has "$out" '2 headings'
run todo "$tasks" "id:twin-two" PROG >/dev/null
check "id: picks one" line "$tasks" '^\* PROG Twin$'

seasons="$HOME/org/seasons.org"
cat >"$seasons" <<'EOF'
* Hockey
** Fall
*** TODO Practice
** Winter
*** TODO Practice
* Basketball
** Winter
*** TODO Practice
* TODO A / B
EOF
out=$(run todo "$seasons" "Practice" DONE)
check "a duplicate suggests a path" has "$out" 'Parent / Practice'
run todo "$seasons" "Fall / Practice" DONE >/dev/null
check "a path picks one" has "$(sed -n 3p "$seasons")" '^\*\*\* DONE Practice$'
out=$(run todo "$seasons" "Winter / Practice" DONE)
check "a path that still matches twice is refused" has "$out" '2 headings'
run todo "$seasons" "Hockey / Winter / Practice" DONE >/dev/null
check "a longer path picks one" has "$(sed -n 6p "$seasons")" '^\*\*\* DONE Practice$'
check "and leaves the other" line "$seasons" '^\*\*\* TODO Practice$'
run todo "$seasons" "A / B" DONE >/dev/null
check "a title with a slash still matches whole" line "$seasons" '^\* DONE A / B$'

run schedule "$tasks" "Plan" "2026-11-03 9:00" >/dev/null
check "schedule writes the weekday" line "$tasks" '^SCHEDULED: <2026-11-03 Tue 09:00>$'
run deadline "$tasks" "Plan" "2026-11-06 -2d" >/dev/null
check "deadline joins the planning line" line "$tasks" 'DEADLINE: <2026-11-06 Fri -2d>'
run schedule "$tasks" "Plan" none >/dev/null
check "none removes SCHEDULED" lacks_line "$tasks" 'SCHEDULED: <2026-11-03'
check "and keeps DEADLINE" line "$tasks" 'DEADLINE: <2026-11-06 Fri -2d>'

bare="$HOME/org/bare.org"
printf '* Pickup\n** TODO Leave\n* Next\n' >"$bare"
run deadline "$bare" "Pickup / Leave" "2026-10-28 15:25" >/dev/null
check "a heading with no body gets its own deadline" has "$(sed -n 3p "$bare")" '^DEADLINE: <2026-10-28 Wed 15:25>$'
check "and the next heading none" has "$(tail -n 1 "$bare")" '^\* Next$'

check "date prints a timestamp" has "$(run date '2026-11-03 9:00-10:30 +1w')" '^<2026-11-03 Tue 09:00-10:30 +1w>$'
check "date takes a relative day" has "$(run date '+0d')" "^<$(TZ=America/Edmonton date +'%Y-%m-%d %a')>$"
check "date refuses words Org would read as today" has "$(run date 'next tuesday')" 'not a date'
check "date refuses a day that does not exist" has "$(run date '2026-02-30 06:00')" 'no such date 2026-02-30; Org would read it as 2026-03-02'
check "date refuses a year Org would clamp" has "$(run date '2999-01-01')" 'no such date 2999-01-01'
shifted="$HOME/org/shifted.org"
printf '* TODO Shifted\n' >"$shifted"
check "schedule refuses a day that does not exist" has "$(run schedule "$shifted" Shifted '2026-02-31')" 'no such date 2026-02-31'
check "a refused date leaves the heading unscheduled" test "$(<"$shifted")" = '* TODO Shifted'
check "missing zone data stops instead of using UTC" has "$(TZDIR=/nonexistent run date '+0d')" 'No zone data for America/Edmonton'

cp "$tasks" "$HOME/org/asana.org"
check "asana.org is refused" has "$(run todo "$HOME/org/asana.org" Plan DONE)" 'never edit it'
cp "$tasks" "$HOME/org/tasks.sync-conflict-20261024-000000-ABC.org"
check "conflict copies are refused" \
  has "$(run todo "$HOME/org/tasks.sync-conflict-20261024-000000-ABC.org" Plan DONE)" 'conflict copy'

content="$HOME/org/content.org"
printf '* TODO Old title\nOld scope.\n' >"$content"
cp "$content" "$fixture/content-before"
revision=$(printf '* TODO Old title\nOld scope.' | sha256sum | cut -d' ' -f1)
printf -v spec '{"revision":"%s","request":"fixture:wrapper","note":"Jon approved the corrected wording.","title":"New title","scope":"New scope."}' "$revision"
export ORG_DISPATCH_ROOT="$HOME/org" ORG_DISPATCH_EMACS_INIT="$fixture/no-init.el"

locked_update() {
  local status=0 lockfd
  exec {lockfd}>"$XDG_RUNTIME_DIR/org-dispatch.lock"
  flock -n "$lockfd"
  bash "$edit" update-task "$content" "Old title" "$spec" >"$fixture/locked-output" 2>&1 || status=$?
  flock -u "$lockfd"
  exec {lockfd}>&-
  [[ $status == 75 ]] && grep -q 'dispatcher or task edit busy' "$fixture/locked-output" && cmp -s "$content" "$fixture/content-before"
}
check "task content edit refuses launch-lock contention without writing" locked_update
out=$(run update-task "$content" "Old title" "$spec")
check "content wrapper returns a successful JSON result" has "$out" '"written":true'
check "content wrapper changes title" line "$content" '^\* TODO New title$'
check "content wrapper replaces legacy scope" line "$content" '^New scope\.$'
cp "$content" "$fixture/content-edited"
out=$(run update-task "$content" "Old title" "$spec")
check "content wrapper replays after rename" has "$out" '"written":false'
check "content replay leaves all bytes alone" cmp -s "$content" "$fixture/content-edited"
check "content edit releases its lock" flock -n "$XDG_RUNTIME_DIR/org-dispatch.lock" true
cp "$org/edit/org-edit.el" "$fixture/org-edit.el"
# Existing command docstrings exceed Emacs's width limit; check code warnings.
compile=$(emacs -Q --batch -L "$org/dispatch" --eval "(setq byte-compile-error-on-warn t byte-compile-warnings '(not docstrings))" -f batch-byte-compile "$fixture/org-edit.el" 2>&1 | grep -v '^Loading' || true)
check "org-edit.el byte-compiles without code warnings" test -z "$compile"

if ((failures)); then
  echo "$failures failed"
  exit 1
fi
echo "all passed"
