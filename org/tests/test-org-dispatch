(ert-deftest unicode-title-settles-launches-and-survives-state-reload ()
  (dolist (test-agent '("pi" "claude"))
    (test-with-hc
     (let* ((title "Respond to Jérôme 東京 é 🐈")
            (task (test-task test-agent))
