#!/usr/bin/env bash
set -euo pipefail

# Batch tests for org-dispatch against fixture Org files. Needs only emacs;
# nothing here calls a real Herdr, starts an agent, or touches ~/org.

org="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
fixture="$(mktemp -d)"
trap 'rm -rf -- "$fixture"' EXIT

export HOME="$fixture/home"
export XDG_STATE_HOME="$fixture/state"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_RUNTIME_DIR="$fixture/runtime"
mkdir -p "$XDG_RUNTIME_DIR"
unset JUNE_CONFIG_DIR HC_TERMINAL_ID CLAUDECODE PI_SESSION_ID
export ORG_DISPATCH_EMACS_INIT="$fixture/no-init.el"
export ORG_DISPATCH_ROOT="$fixture/org"
export ORG_DISPATCH_PROMPTS="$org/prompts"
export ORG_DISPATCH_HOST=kit
export ORG_DISPATCH_SETTLE=0
export ORG_DISPATCH_LOG_KEEP=2
export PATH="$fixture/bin:$PATH"
# Never Jon's roster: without june, a task runs on the harness it names; roster tests bring their own.
export ORG_DISPATCH_JUNE="$fixture/bin/no-june"
# Some checks load org-dispatch.el directly, without the script that finds NixOS zone data.
if [[ -z ${TZDIR:-} && ! -d /usr/share/zoneinfo && -d /etc/zoneinfo ]]; then export TZDIR=/etc/zoneinfo; fi
mkdir -p "$HOME" "$ORG_DISPATCH_ROOT" "$fixture/bin"
# A failing hc keeps every lookup away from any real core.
printf '#!/bin/sh\nexit 1\n' >"$fixture/bin/hc"
chmod +x "$fixture/bin/hc"

dispatch="$org/dispatch/org-dispatch"
failures=0

check() {
  local name=$1
  shift
  if "$@"; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    failures=$((failures + 1))
  fi
}

# Run org-dispatch, keeping only its own output, not Emacs's loading chatter.
run() { "$dispatch" "$@" 2>&1 | grep -v -e '^Loading' -e 'could not read org-agenda-files' || true; }
has() { grep -q -- "$2" <<<"$1"; }
lacks() { ! grep -q -- "$2" <<<"$1"; }
line() { grep -q -- "$2" "$1"; }

# Scan: which headings this host would launch. The dispatcher runs one task per
# directory, so each heading gets a directory of its own.
n=0
task() { n=$((n + 1)); mkdir -p "$ORG_DISPATCH_ROOT/scan$n"; printf '%s\n' "$@" >"$ORG_DISPATCH_ROOT/scan$n/scan$n.org"; }
task '* AUTO Launch me :kit:'
task "* TODO Jon's own task :kit:"
task '* AUTO No host or agent'
task '* AUTO Two hosts :kit:cog:'
task '* AUTO The other host :cog:'
task '* AUTO Not yet :kit:' 'SCHEDULED: <2999-01-01 Tue 06:00>'
task '#+FILETAGS: :kit:' '* AUTO Host from the file'
task '#+FILETAGS: :kit:' '* AUTO Heading tag over the file :cog:'
task '* AUTO Agent and host :pi:kit:'
task '* AUTO Host and agent :kit:pi:'
task '* AUTO Launch Claude :claude:kit:'
task '* AUTO Two agents :pi:claude:'
task '* AUTO The drawer beats the tags :cog:claude:' ':PROPERTIES:' ':HOST: kit' ':AGENT: pi' ':END:'
task '* AUTO The drawer sends it away :kit:' ':PROPERTIES:' ':HOST: cog' ':END:'
task '* AUTO An unknown host :kit:' ':PROPERTIES:' ':HOST: mars' ':END:'
# Keep only the task lines, not the log lines that name skipped headings.
log=$(ORG_DISPATCH_MAX_AGENTS=20 run scan)
scan=$(grep $'\t' <<<"$log" || true)
check "scan lists an AUTO heading tagged with this host" has "$scan" "Launch me"
check "scan skips TODO headings" lacks "$scan" "Jon's own task"
check "scan gives an untagged AUTO June's default host and agent" has "$scan" "No host or agent"
check "scan skips AUTO tagged for two hosts" lacks "$scan" "Two hosts"
check "scan skips AUTO for the other host" lacks "$scan" "The other host"
check "scan skips AUTO scheduled in the future" lacks "$scan" "Not yet"
check "scan takes the host from #+FILETAGS" has "$scan" "Host from the file"
check "a heading's host tag wins over the file's" lacks "$scan" "Heading tag over the file"
check "scan takes an agent and host tag in either order" has "$scan" "Agent and host"
check "scan takes a host and agent tag in either order" has "$scan" "Host and agent"
check "scan lists a Claude task for this host" has "$scan" "Launch Claude"
check "scan skips AUTO tagged for two agents" lacks "$scan" "Two agents"
check "the drawer's HOST and AGENT beat the tags" has "$scan" "The drawer beats the tags"
check "the drawer's HOST sends a kit-tagged task elsewhere" lacks "$scan" "The drawer sends it away"
check "scan skips an unknown HOST" lacks "$scan" "An unknown host"
check "the log says why two hosts were skipped" has "$log" "Two hosts: tagged for kit and cog"
check "the log names an unknown HOST" has "$log" "HOST mars is not one of"

# June's config sets the defaults.
mkdir -p "$HOME/.config/june"
printf '{"dispatch": {"hosts": ["kit"], "host": "cog", "agent": "claude"}}\n' >"$HOME/.config/june/config.json"
scan=$(ORG_DISPATCH_MAX_AGENTS=20 run scan | grep $'\t' || true)
check "June's default host applies to an untagged AUTO" lacks "$scan" "No host or agent"
check "a host tag still beats the default" has "$scan" "Launch me"
rm -r "$HOME/.config/june"
for ((i = 1; i <= n; i++)); do rm -r "$ORG_DISPATCH_ROOT/scan$i"; done

# Settling: a typed heading waits; one June wrote whole launches at once.
mkdir -p "$ORG_DISPATCH_ROOT/typed" "$ORG_DISPATCH_ROOT/june"
printf '* AUTO Typed by Jon :kit:\n' >"$ORG_DISPATCH_ROOT/typed/typed.org"
printf '* AUTO Written by June :kit:\n:PROPERTIES:\n:JUNE_REQUEST: test:1\n:END:\n' >"$ORG_DISPATCH_ROOT/june/june.org"
scan=$(ORG_DISPATCH_SETTLE=600 run scan | grep $'\t' || true)
check "scan holds a typed heading while it settles" has "$scan" $'Typed by Jon\t.*\tsettling'
check "scan launches a June heading without settling" has "$scan" $'Written by June\t.*\tnew'
mkdir -p "$HOME/.config/june"
printf '{"dispatch": {"settle": 600}}\n' >"$HOME/.config/june/config.json"
scan=$(ORG_DISPATCH_SETTLE= run scan | grep $'\t' || true)
check "June's dispatch.settle applies without the variable" has "$scan" $'Typed by Jon\t.*\tsettling'
scan=$(run scan | grep $'\t' || true)
check "the variable beats dispatch.settle" has "$scan" $'Typed by Jon\t.*\tnew'
rm -r "$HOME/.config/june"
rm -r "$ORG_DISPATCH_ROOT/typed" "$ORG_DISPATCH_ROOT/june"

# Retry: allowed, refused, and what it leaves behind.
retry_file="$ORG_DISPATCH_ROOT/retry.org"
cat >"$retry_file" <<'EOF'
* PROG Wait for upstream :kit:auto:
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000001
:RETRY:    1
:END:

Body stays.

** Sessions

- [[herdr:kit/pi:aaaa@w1:p1][pi@kit/2026-10-14T0550]]

** Dialog

- Jon [2026-10-13 Tue 22:00]: go
* PROG No retries granted :kit:
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000002
:END:
* PROG Repeating :kit:
SCHEDULED: <2026-10-14 Wed 04:30 +1d>
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000003
:RETRY:    3
:END:
* PROG Date only :kit:
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000008
:RETRY:    1
:END:
* HOLD Not running :kit:
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000004
:RETRY:    3
:END:
EOF
out=$(run retry 00000000-0000-0000-0000-000000000001 "+1d 06:00" "upstream lacks the fix")
check "retry reports AUTO with no retries left" has "$out" "is now AUTO, scheduled for .* 06:00> with 0 retries left"
check "retry sets AUTO, drops :auto:, and pads no tags" line "$retry_file" "^\* AUTO Wait for upstream :kit:$"
check "retry keeps the time of day" line "$retry_file" "^SCHEDULED: <.* 06:00>$"
check "retry lowers RETRY" line "$retry_file" "^:RETRY: *0$"
check "retry logs the session link" line "$retry_file" "\[\[herdr:kit/pi:aaaa@w1:p1\].*Retry <"
check "retry removes Sessions" bash -c "! grep -q '^\*\* Sessions' '$retry_file'"
check "retry keeps Dialog" line "$retry_file" "^- Jon \[2026-10-13 Tue 22:00\]: go$"
check "retry keeps the body" line "$retry_file" "^Body stays.$"
run retry 00000000-0000-0000-0000-000000000008 +3d "no time given" >/dev/null
check "retry without a time schedules a date only" line "$retry_file" "^SCHEDULED: <[0-9-]* [A-Za-z]*>$"
check "retry refuses a task that is not PROG" has "$(run retry 00000000-0000-0000-0000-000000000001 +2d note)" "only a running task can retry"
check "retry refuses without RETRY" has "$(run retry 00000000-0000-0000-0000-000000000002 +1d note)" "Jon allowed no more retries"
check "retry refuses a repeating task" has "$(run retry 00000000-0000-0000-0000-000000000003 +1d note)" "a repeating task recurs on its own"
check "retry refuses HOLD" has "$(run retry 00000000-0000-0000-0000-000000000004 +1d note)" "only a running task can retry"
check "retry refuses a date too soon" has "$(run retry 00000000-0000-0000-0000-000000000004 +0d note)" "less than 15 minutes away"
check "retry refuses an empty note" has "$(run retry 00000000-0000-0000-0000-000000000004 +1d)" "usage: org-dispatch retry"

# Finish: a repeat returns to AUTO, logs the run, and trims old entries.
repeat_file="$ORG_DISPATCH_ROOT/repeat.org"
cat >"$repeat_file" <<'EOF'
* PROG Daily check :kit:auto:
SCHEDULED: <2026-10-14 Wed 04:30 +1d>
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000005
:REPEAT_TO_STATE: AUTO
:REVIEW:   no
:END:
:LOGBOOK:
- State "DONE"       from "PROG"       [2026-10-13 Tue 04:31] \\
  Second run.
- State "DONE"       from "PROG"       [2026-10-12 Mon 04:31] \\
  First run.
:END:

Standing instructions.

** Sessions

- [[herdr:kit/pi:bbbb@w2:p1][pi@kit/2026-10-14T0430]]
* PROG Reviewed one-off :kit:auto:
:PROPERTIES:
:ID:       00000000-0000-0000-0000-000000000006
:END:
EOF
out=$(run finish 00000000-0000-0000-0000-000000000005 DONE "No change." --headline "Checked again. Nothing changed!")
check "finish returns a repeat to AUTO" has "$out" "is now AUTO"
check "finish advances the repeat, drops :auto:, and pads no tags" line "$repeat_file" "^\* AUTO Daily check :kit:$"
check "finish advances SCHEDULED" line "$repeat_file" "^SCHEDULED: <2026-10-15 Thu 04:30 +1d>$"
check "finish logs the run with its session" line "$repeat_file" "\[\[herdr:kit/pi:bbbb@w2:p1\].*No change.$"
check "finish keeps ORG_DISPATCH_LOG_KEEP entries" bash -c "[[ \$(grep -c '^- State \"DONE\"' '$repeat_file') -eq 2 ]]"
check "finish archives the oldest entry" line "$ORG_DISPATCH_ROOT/archive.org" "^  First run.$"
check "the archive names the task" line "$ORG_DISPATCH_ROOT/archive.org" "^:ARCHIVE_ID: 00000000-0000-0000-0000-000000000005$"
check "a repeat keeps only this run's headline in its drawer" line "$repeat_file" '^:HEADLINE: *Checked again\. Nothing changed!$'
check "a repeat binds its headline to DONE, not its next AUTO" line "$repeat_file" '^:HEADLINE_STATE: *DONE$'
check "finish stamps the report in Unix seconds" line "$repeat_file" '^:HEADLINE_AT: *[0-9][0-9]*\.[0-9][0-9]*$'
emacs -Q --batch -l "$org/dispatch/org-dispatch.el" --eval "
  (with-current-buffer (find-file-noselect \"$repeat_file\")
    (goto-char (point-min))
    (org-dispatch--claim (org-dispatch--task) \"p1\" \"new-session\"))" >/dev/null 2>&1
check "claiming the next repeat clears its headline and stamp" bash -c "! grep -q '^:HEADLINE' '$repeat_file'"
run finish 00000000-0000-0000-0000-000000000005 DONE "Still no change." --headline "Fresh check. Still no change!" >/dev/null
check "the next repeat replaces the headline" line "$repeat_file" '^:HEADLINE: *Fresh check\. Still no change!$'
out=$(run finish 00000000-0000-0000-0000-000000000006 DONE "Done." --headline "Done, checks pass!")
check "finish turns DONE into EVAL when Jon reviews" has "$out" "is now EVAL"
check "finish records the worker's exact headline even when DONE becomes EVAL" line "$repeat_file" '^:HEADLINE: *Done, checks pass!$'
check "finish leaves the note separate from the headline" line "$repeat_file" '^:DISPATCH_FINISH: *Done\.$'
check "review coercion binds the headline to EVAL" line "$repeat_file" '^:HEADLINE_STATE: *EVAL$'
run finish 00000000-0000-0000-0000-000000000006 HOLD "Which copy should I keep?" --headline "I'm stuck. Which copy do I keep?" >/dev/null
check "HOLD records a fresh headline" line "$repeat_file" "^:HEADLINE: *I'm stuck\. Which copy do I keep?$"
check "HOLD keeps its question in Dialog" line "$repeat_file" '^- Agent .*: Which copy should I keep?$'
check "HOLD replaces the previous headline state" line "$repeat_file" '^:HEADLINE_STATE: *HOLD$'
check "finish refuses a multiline headline" has "$(run finish 00000000-0000-0000-0000-000000000006 EVAL note --headline $'two\nlines')" '--headline needs one non-empty line'
check "finish refuses an empty headline" has "$(run finish 00000000-0000-0000-0000-000000000006 EVAL note --headline '')" '--headline needs one non-empty line'
check "finish refuses a headline it would have to trim" has "$(run finish 00000000-0000-0000-0000-000000000006 EVAL note --headline ' padded ')" '--headline needs one non-empty line'
check "finish refuses a missing headline argument" has "$(run finish 00000000-0000-0000-0000-000000000006 EVAL note --headline)" '--headline needs one non-empty line'
run finish 00000000-0000-0000-0000-000000000006 EVAL "Legacy finish, no headline." >/dev/null
check "a legacy finish removes a previous headline" lacks "$(grep '^:HEADLINE:' "$repeat_file")" "I'm stuck"
check "a legacy finish also clears the freshness binding" bash -c "! grep -Eq '^:HEADLINE_STATE: *(EVAL|HOLD)$' '$repeat_file'"
check "finish drops :auto:" line "$repeat_file" "^\* EVAL Reviewed one-off :kit:$"
check "finish refuses HOLD without what it waits for" has "$(run finish 00000000-0000-0000-0000-000000000006 HOLD)" "HOLD needs what the task waits for"
check "finish refuses ASK without a question" has "$(run finish 00000000-0000-0000-0000-000000000006 ASK)" "ASK needs the question for Jon"
check "finish refuses AUTO" has "$(run finish 00000000-0000-0000-0000-000000000006 AUTO note)" "STATE must be EVAL, ASK, HOLD, or DONE"
# ASK puts a question to Jon: EVAL, the question in Dialog, an ASKED stamp; a later plain EVAL is ready for review.
emacs -Q --batch -l "$org/dispatch/org-dispatch.el" --eval "
  (org-dispatch--edit \"$repeat_file\" \"00000000-0000-0000-0000-000000000006\" (lambda () (org-todo \"PROG\")))" >/dev/null 2>&1
out=$(run finish 00000000-0000-0000-0000-000000000006 ASK "1. Keep the old copy?" --headline "Two copies; which do I keep?")
check "ASK reports a question at EVAL" has "$out" "is now EVAL (asked)"
check "ASK leaves the task at EVAL" line "$repeat_file" "^\* EVAL Reviewed one-off :kit:$"
check "ASK keeps its question in Dialog" line "$repeat_file" '^- Agent .*: 1\. Keep the old copy?$'
check "ASK stamps ASKED" line "$repeat_file" '^:ASKED: *\[20[0-9-]* [A-Za-z]* [0-9:]*\]$'
check "ASK binds its headline to EVAL" line "$repeat_file" '^:HEADLINE_STATE: *EVAL$'
emacs -Q --batch -l "$org/dispatch/org-dispatch.el" --eval "
  (org-dispatch--edit \"$repeat_file\" \"00000000-0000-0000-0000-000000000006\" (lambda () (org-todo \"PROG\")))" >/dev/null 2>&1
check "leaving EVAL answers the question" bash -c "! grep -q '^:ASKED:' '$repeat_file'"
run finish 00000000-0000-0000-0000-000000000006 ASK "Again?" >/dev/null
run finish 00000000-0000-0000-0000-000000000006 EVAL "Done after all." >/dev/null
check "a plain EVAL finish is ready for review, not a question" bash -c "! grep -q '^:ASKED:' '$repeat_file'"

# Prompt: the retry rule appears only when Jon allowed a retry.
render() {
  local file="$ORG_DISPATCH_ROOT/render.org"
  printf '* AUTO Render :kit:\n%b:PROPERTIES:\n:ID: 00000000-0000-0000-0000-000000000007\n:RETRY: %s\n:END:\n' "$2" "$1" >"$file"
  emacs -Q --batch -l "$org/dispatch/org-dispatch.el" --eval "
    (with-current-buffer (find-file-noselect \"$file\")
      (goto-char (point-min))
      (princ (org-dispatch--render \"task\" (org-dispatch--task) '((\"DIALOG\" . \"\")))))" 2>/dev/null
}
check "the prompt offers retry when RETRY is set" has "$(render 2 '')" "org-dispatch retry 00000000-0000-0000-0000-000000000007"
check "the prompt counts the retries left" has "$(render 1 '')" "allowed 1 more retry\."
check "the prompt omits retry at RETRY 0" lacks "$(render 0 '')" "org-dispatch retry 0000"
check "the prompt omits retry for a repeat" lacks "$(render 2 'SCHEDULED: <2026-10-15 Thu 04:30 +1d>\n')" "org-dispatch retry 0000"
check "the prompt fills every placeholder" lacks "$(render 2 '')" "{{"
check "the prompt asks for the worker's own headline" has "$(render 0 '')" 'one-line headline in your own voice'
check "the prompt passes the headline on EVAL, ASK and HOLD" bash -c '[[ $(grep -c -- "org-dispatch finish .* --headline" <<<"$1") -eq 3 ]]' _ "$(render 0 '')"
check "the prompt sends questions through ASK, not HOLD" has "$(render 0 '')" 'finish 00000000-0000-0000-0000-000000000007 ASK "question"'
check "the prompt keeps HOLD for outside blockers" has "$(render 0 '')" 'HOLD means Jon has nothing to do yet'
review_file="$ORG_DISPATCH_ROOT/agent-review.org"
printf '%s\n' '* PROG Standing review :kit:' ':PROPERTIES:' ':ID: 00000000-0000-0000-0000-000000000031' ':REVIEW: agent' ':END:' >"$review_file"
agent_policy=$(emacs -Q --batch -l "$org/dispatch/org-dispatch.el" --eval "
  (with-current-buffer (find-file-noselect \"$review_file\")
    (goto-char (point-min))
    (princ (org-dispatch--policy (org-dispatch--task))))" 2>/dev/null)
check "REVIEW agent tells the worker an agent reviews its exact commit" has "$agent_policy" 'An independent agent reviews this task.s exact commit'
rm -f "$review_file"

# Claiming writes the resolved HOST and AGENT into the drawer once, beside ID.
claim_file="$ORG_DISPATCH_ROOT/claim.org"
printf '* AUTO Claim me :pi:cog:\n:PROPERTIES:\n:HEADLINE: Old result.\n:END:\n* AUTO Keep my drawer :kit:\n:PROPERTIES:\n:HOST: cog\n:HEADLINE: Old question.\n:END:\n' >"$claim_file"
claim() {
  emacs -Q --batch -l "$org/dispatch/org-dispatch.el" --eval "
    (with-current-buffer (find-file-noselect \"$claim_file\")
      (org-mode)
      (goto-char (point-min))
      (search-forward \"$1\")
      (let ((task (org-dispatch--task)))
        (org-dispatch--claim (plist-put task :id \"$2\") \"p1\" \"5e55\")))" >/dev/null 2>&1
}
claim "Claim me" 00000000-0000-0000-0000-0000000000c1
claim "Keep my drawer" 00000000-0000-0000-0000-0000000000c2
check "a claim writes the tagged host" line "$claim_file" '^:HOST: *cog$'
check "a claim writes the tagged agent" line "$claim_file" '^:AGENT: *pi$'
check "a claim keeps the ID beside them" line "$claim_file" '^:ID: *00000000-0000-0000-0000-0000000000c1$'
check "a claim leaves an existing HOST and the tags, adding only :auto:" bash -c "[[ \$(grep -c '^:HOST:' '$claim_file') -eq 2 ]] && ! grep -q '^:HOST: *kit' '$claim_file' && grep -q '^\* PROG Keep my drawer :kit:auto:$' '$claim_file'"
check "a claim fills the default agent" bash -c "[[ \$(grep -c '^:AGENT: *pi$' '$claim_file') -eq 2 ]]"
check "resumed claims clear old results and questions" bash -c "! grep -q '^:HEADLINE' '$claim_file'"
rm "$claim_file"

# herdr-link: a fake hc records its arguments, knows one project space, and has
# a live terminal only when FAKE_LIVE names one.
cat >"$fixture/bin/hc" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$FAKE_HC_LOG"
case "$1" in
  ls)
    if [[ "$*" == *org.session=* ]]; then
      if [[ -n ${FAKE_LIVE:-} ]]; then printf '{"terminals":[{"address":"%s","state":"live"}]}\n' "$FAKE_LIVE"
      else echo '{"terminals":[]}'; fi
    else
      printf '{"terminals":%s}\n' "${FAKE_TERMINALS:-[]}"
    fi ;;
  get) echo '{"address":"t-june","state":"live","labels":{"herdr.space":"sp-june","where":"june / 1"}}' ;;
  run) echo '{"address":"t-new"}' ;;
  label|attach) ;;
  *) exit 1 ;;
esac
EOF
# The Nix sandbox has no /usr/bin/env, so point the script at this bash.
sed -i "1s|.*|#!$BASH|" "$fixture/bin/hc"
chmod +x "$fixture/bin/hc"
export FAKE_HC_LOG="$fixture/hc.log"
export FAKE_SESSION=01234567-89ab-cdef-0123-456789abcdef
host=$(</proc/sys/kernel/hostname)
june_space='[{"address":"t-june","state":"live","where":"[8] June / 1"},{"address":"t-bug","state":"live","where":"junebug / 1"}]'
link() { rm -f "$FAKE_HC_LOG"; "$org/bin/herdr-link" attach "herdr:$host/$1:$FAKE_SESSION@w1:p1" >/dev/null 2>&1 || true; cat "$FAKE_HC_LOG" 2>/dev/null; }

# A live session is found by its label and attached, whatever the link's pane hint says.
calls=$(FAKE_LIVE=t-live link pi)
check "herdr-link finds a live session by its label" has "$calls" "^ls --json --label org.session=$FAKE_SESSION$"
check "herdr-link attaches to the labelled terminal" has "$calls" "^attach t-live$"
check "herdr-link starts nothing for a live session" lacks "$calls" "^run "

# A closed dispatched session reopens in the space of the Org file that links it.
mkdir -p "$HOME/.pi/agent/sessions/x" "$HOME/org/work/suderman/june"
printf '{"type":"session","cwd":"/tmp"}\n{"type":"session_info","name":"auto · Fix the thing"}\n' \
  >"$HOME/.pi/agent/sessions/x/2026_$FAKE_SESSION.jsonl"
printf '* EVAL Fix the thing\n** Sessions\n- [[herdr:kit/pi:%s@w1:p1][pi@kit/2026-10-26T1500]]\n' "$FAKE_SESSION" \
  >"$HOME/org/work/suderman/june/june.org"
calls=$(FAKE_TERMINALS=$june_space link pi)
check "herdr-link reopens pi in its project's space, labelled and parentless" has "$calls" \
  "^run --json --bg --no-parent --cwd /tmp --label org.agent=pi --label org.session=$FAKE_SESSION --label herdr.space=sp-june -- sh -c exec pi --session .*2026_$FAKE_SESSION.jsonl$"
check "herdr-link reads only the matching project's space" lacks "$calls" "^get --json t-bug"
check "herdr-link attaches to the reopened terminal" has "$calls" "^attach t-new$"
calls=$(FAKE_TERMINALS='[]' link pi)
check "herdr-link reopens without a space when the project has none" has "$calls" "^run --json --bg --no-parent --cwd /tmp --label org.agent=pi --label org.session=$FAKE_SESSION -- "
rm "$HOME/org/work/suderman/june/june.org"
calls=$(FAKE_TERMINALS=$june_space link pi)
check "herdr-link without a linking file opens without a space" lacks "$calls" "herdr.space="

# Claude stores its display name as custom-title, not pi's session_info. Account
# launchers fix CLAUDE_CONFIG_DIR, so the default directory resumes through
# claude-direct with the directory named, and status reporting is switched on.
mkdir -p "$HOME/.claude/projects/x"
printf '{"type":"user","cwd":"/tmp"}\n{"type":"custom-title","customTitle":"auto · Fix the thing"}\n' \
  >"$HOME/.claude/projects/x/$FAKE_SESSION.jsonl"
printf '* EVAL Fix the thing\n** Sessions\n- [[herdr:kit/claude:%s@t7][claude@kit/2026-10-26T1500]]\n' "$FAKE_SESSION" \
  >"$HOME/org/work/suderman/june/june.org"
printf '#!/bin/sh\nexit 0\n' >"$fixture/bin/claude-direct"
chmod +x "$fixture/bin/claude-direct"
calls=$(FAKE_TERMINALS=$june_space link claude)
check "herdr-link reopens Claude in its project's space" has "$calls" "^run .*--label herdr.space=sp-june -- "
check "herdr-link resumes Claude by ID in its config directory" has "$calls" \
  "^run .* -- sh -c exec CLAUDE_CONFIG_DIR='$HOME/.claude' claude-direct --resume $FAKE_SESSION --settings "
check "herdr-link turns on Claude's status reporting" has "$calls" 'CLAUDE_CODE_DISABLE_TERMINAL_TITLE":""'
# Historical links still route to native resume after immediate archive. hc
