(ert-deftest roster-agents-launch-with-their-card-and-become-the-task-agent ()
  ;; June picks among AGENTS. The card's model, effort and instructions reach the
  ;; harness, the terminal carries june.agent so June shows it busy, the task
  ;; names the agent from then on, and a second task in the pass skips it.
  (let* ((bin (make-temp-file "june-bin" t))
         (org-dispatch-june (expand-file-name "june" bin))
         (calls (expand-file-name "calls" bin))
         (org-dispatch-max-agents 10))
    (with-temp-file org-dispatch-june
      (insert "#!/bin/sh\necho \"$*\" >> " calls "\n"
              "echo '{\"chosen\":\"bolt\",\"why\":\"bolt is the first available\",\"card\":"
              "{\"name\":\"Bolt\",\"slug\":\"bolt\",\"host\":\"kit\",\"harness\":\"claude\","
              "\"model\":\"claude-opus-5-5\",\"effort\":\"high\",\"instructions\":\"Be careful.\",\"problems\":[]}}'\n"))
    (set-file-modes org-dispatch-june #o755)
    (unwind-protect
        (test-with-hc
         (let* ((one (test-roster-task 1 "bolt sprocket"))
                (two (test-roster-task 2 "bolt sprocket"))
                (chosen (org-dispatch--eligible (list one two) nil)))
           (should-not (plist-get one :agent))
           (should (equal (plist-get one :roster) '("bolt" "sprocket")))
           (should (equal (mapcar (lambda (task) (plist-get task :agent)) chosen) '("claude" "claude")))
           (should (equal org-dispatch-launchable '("claude" "codex" "pi" "agy")))
           (should (equal (split-string (with-temp-buffer (insert-file-contents calls) (buffer-string)) "\n" t)
                          (let ((hs (string-join org-dispatch-launchable ",")))
                            (list (format "agents pick --json --host kit --harnesses %s bolt sprocket" hs)
                                  (format "agents pick --json --host kit --harnesses %s --except bolt bolt sprocket" hs)))))
           (should (org-dispatch--launch (car chosen)))
           (let ((run (test-run-call)) (argv (test-argv)))
             (should (equal (car argv) "claude"))
             (should (equal (cadr (member "--model" argv)) "claude-opus-5-5"))
             (should (equal (cadr (member "--effort" argv)) "high"))
             (should (equal (cadr (member "--append-system-prompt" argv)) "Be careful."))
             (should (member "june.agent=bolt" run))
             (should (member "org.agent=claude" run)))
           (org-dispatch--edit (plist-get one :file) (plist-get one :id)
                               (lambda ()
                                 (should (equal (org-entry-get nil "AGENT") "bolt"))
                                 (should (equal (org-get-todo-state) "PROG"))))))
      (delete-directory bin t)
      (dolist (file (file-expand-wildcards (expand-file-name "roster-*.org" org-dispatch-root)))
        (delete-file file))
      (dolist (state (org-dispatch--states)) (org-dispatch--drop-state (plist-get state :id))))))

