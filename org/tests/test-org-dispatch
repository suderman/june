# Launch and watch tests exercise the real Org edits and state, with only hc mocked.
cat >"$fixture/launch-tests.el" <<'EOF'
;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defvar test-session "01234567-89ab-cdef-0123-456789abcdef")
(defvar test-calls nil)
(defvar test-agent "pi")
(defvar test-status "idle")
(defvar test-terminals nil "Fake hc terminals: alist of address to record.")
(defvar test-next 0)
(defvar test-spawn-fail nil)
(defvar test-exit-at-start nil)

(defun test-labels (pairs)
  (mapcar (lambda (pair) (let ((kv (split-string pair "="))) (cons (intern (car kv)) (cadr kv)))) pairs))

(defun test-terminal (address agent session &optional extra)
  "Add a live terminal running AGENT's SESSION at ADDRESS."
  (push (cons address `((address . ,address) (state . "live")
                        (status (state . ,test-status)) (turn . 1) (status_ms . 1) (pid . 1)
                        (labels . ,(append (test-labels (list (concat "org.agent=" agent)
                                                              (concat "org.session=" session)))
                                           extra))))
        test-terminals))

(defun test-not-found (address)
  (signal 'org-dispatch-hc (list "not_found" (format "no terminal %s" address))))

(defun test-hc (&rest args)
  (push args test-calls)
  (pcase args
    (`("run" . ,rest)
     (when test-spawn-fail (signal 'org-dispatch-hc (list "spawn_failed" "cannot start")))
     (let* ((address (format "t-new%s" (if (zerop test-next) "" test-next)))
            (labels nil))
       (setq test-next (1+ test-next))
       (while rest
         (let ((arg (pop rest)))
           (when (equal arg "--label") (push (pop rest) labels))
           (when (equal arg "--") (setq rest nil))))
       (push (cons address `((address . ,address)
                             (state . ,(if test-exit-at-start "finished" "live"))
                             (exit_code . ,(and test-exit-at-start 1))
                             (status . ,(and test-status `((state . ,test-status))))
                             (turn . 0) (status_ms . 1) (pid . 2)
                             (labels . ,(test-labels labels))))
             test-terminals)
       `((address . ,address))))
    (`("get" ,address)
     (or (cdr (assoc address test-terminals)) (test-not-found address)))
    (`("ls" . ,rest)
     (let* ((filter (cadr (member "--label" rest)))
            (kv (and filter (split-string filter "=")))
            (all (member "--all" rest)))
       `((terminals . ,(vconcat
                        (mapcar (lambda (pair)
                                  ;; Rows as hc ls prints them: no labels, but state and where.
                                  `((address . ,(car pair)) (state . ,(alist-get 'state (cdr pair)))
                                    (where . ,(alist-get 'where (alist-get 'labels (cdr pair))))))
                                (seq-filter (lambda (pair)
                                              (and (or all (equal (alist-get 'state (cdr pair)) "live"))
                                                   (or (null kv)
                                                       (equal (alist-get (intern (car kv))
                                                                         (alist-get 'labels (cdr pair)))
                                                              (cadr kv)))))
                                            test-terminals)))))))
    (`("label" ,address . ,pairs)
     (let ((record (or (cdr (assoc address test-terminals)) (test-not-found address))))
       (setf (alist-get 'labels record)
             (append (test-labels pairs)
                     (seq-remove (lambda (old) (assoc (car old) (test-labels pairs)))
                                 (alist-get 'labels record))))
       (setf (cdr (assoc address test-terminals)) record)
       nil))
    (`("send" ,address ,_)
     (let ((record (or (cdr (assoc address test-terminals)) (test-not-found address))))
       (when (equal (org-dispatch--get record 'status 'state) "blocked")
         (signal 'org-dispatch-hc (list "blocked" "blocked")))
       '((started . t))))
    (`("interrupt" ,_) '((outcome . "stopped")))
    (_ nil)))

(defun test-task (agent &optional resume)
  (let ((file (expand-file-name "launch.org" org-dispatch-root)))
    (make-directory org-dispatch-root t)
    (with-temp-file file
      (insert (format "* AUTO Test launch\n:PROPERTIES:\n:ID: 00000000-0000-0000-0000-000000000099\n:HOST: kit\n:AGENT: %s\n:END:\n" agent))
      (when resume
        (insert (format "\n** Sessions\n- [[herdr:kit/%s:%s@t-old][old]]\n" agent test-session))))
    (org-dispatch--edit file "00000000-0000-0000-0000-000000000099" #'org-dispatch--task)))

(defmacro test-with-hc (&rest body)
  `(let ((test-calls nil) (test-status "idle") (test-terminals nil) (test-next 0)
         (test-spawn-fail nil) (test-exit-at-start nil))
     (dolist (state (org-dispatch--states)) (org-dispatch--drop-state (plist-get state :id)))
     (cl-letf (((symbol-function 'org-dispatch--hc) #'test-hc)
               ((symbol-function 'sleep-for) #'ignore))
       ,@body)))

(defun test-run-call ()
  (seq-find (lambda (args) (equal (car args) "run")) test-calls))

(defun test-argv (&optional call)
  "The agent argv of a recorded hc run CALL."
  (cdr (member "--" (or call (test-run-call)))))

(defun test-sent (text)
  (seq-find (lambda (args) (and (equal (car args) "send") (string-search text (nth 2 args)))) test-calls))

