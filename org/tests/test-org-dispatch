(ert-deftest stop-interrupts-then-kills-only-the-exact-worker ()
  (test-with-hc
   (let ((task (test-task "pi")))
     (should (org-dispatch--launch task))
     (let ((state (car (org-dispatch--states))))
       ;; Settled workers are left running.
       (should (equal (org-dispatch--interrupt-session state) "settled"))
       ;; A working agent that stops at the interrupt.
       (setf (alist-get 'status (cdr (assoc "t-new" test-terminals))) '((state . "working")))
       (cl-letf (((symbol-function 'test-hc-interrupt) nil))
         (let ((orig (symbol-function 'org-dispatch--hc)))
           (cl-letf (((symbol-function 'org-dispatch--hc)
                      (lambda (&rest args)
                        (when (equal (car args) "interrupt")
                          (setf (alist-get 'status (cdr (assoc "t-new" test-terminals))) '((state . "idle"))))
                        (apply orig args))))
             (should (equal (org-dispatch--interrupt-session state) "interrupted")))))
       ;; One that ignores it is killed, after its labels are checked again.
       (setf (alist-get 'status (cdr (assoc "t-new" test-terminals))) '((state . "working")))
       (let ((orig (symbol-function 'org-dispatch--hc)) (clock 0))
         (cl-letf (((symbol-function 'float-time) (lambda (&rest _) (setq clock (+ clock 5))))
                   ((symbol-function 'org-dispatch--hc)
                    (lambda (&rest args)
                      (when (equal (car args) "kill")
                        (setf (alist-get 'state (cdr (assoc "t-new" test-terminals))) "finished"))
                      (apply orig args))))
           (should (equal (org-dispatch--interrupt-session state) "killed"))))
       (should (seq-find (lambda (args) (equal args '("kill" "t-new"))) test-calls))
       (should (equal (org-dispatch--interrupt-session state) "gone"))
       ;; A terminal from another run is never touched.
       (setq test-terminals nil test-calls nil)
       (test-terminal "t-other" "pi" (plist-get state :session) '((org.run . "other-run")))
       (setf (alist-get 'status (cdr (assoc "t-other" test-terminals))) '((state . "working")))
       (should-error (org-dispatch--interrupt-session state))
       (should-not (seq-find (lambda (args) (member (car args) '("interrupt" "kill"))) test-calls))))))

(ert-deftest watch-drops-auto-when-jon-changes-the-state-outside-batch-org ()
  (test-with-hc
   (let* ((task (test-task "pi"))
          (file (plist-get task :file)))
     (should (org-dispatch--launch task))
     ;; As Jon's Emacs would save it, without the dispatcher's hook.
