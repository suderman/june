       (org-dispatch--edit file (plist-get task :id)
                           (lambda () (org-edit-headline title) (org-entry-delete nil "ID")))
       (setq task (org-dispatch--edit file nil #'org-dispatch--task title))
       ;; Without an ID, the settling key contains the title. A second pass reads it back.
       (dotimes (_ 2)
         (should (equal (org-dispatch--eligible (list task) nil) (list task))))
       (with-temp-buffer
         (insert-file-contents (org-dispatch--pending-file))
         (should (gethash (concat file "::" title) (json-parse-buffer))))
