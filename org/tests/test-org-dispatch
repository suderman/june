                           (should-not (org-get-tags nil t)))))))

(ert-run-tests-batch-and-exit)
EOF
check "launch, resume, session identity, and watch for pi and Claude" \
  env XDG_STATE_HOME="$fixture/launch-state" ORG_DISPATCH_ROOT="$fixture/launch-org" \
  emacs -Q --batch -l "$org/dispatch/org-dispatch.el" -l "$fixture/launch-tests.el"

check "dependencies, handoffs, and recoverable plan queuing" \
  emacs -Q --batch -l "$org/dispatch/org-dispatch.el" -l "$org/tests/dependencies.el"

check "worker retirement eligibility, stability, races and reopening" \
  emacs -Q --batch -l "$org/dispatch/org-dispatch.el" -l "$org/tests/retirement.el"

check "safe task interruption, parking, replay and reassignment" \
  emacs -Q --batch -L "$org/dispatch" -L "$org/edit" -l "$org/tests/stop.el"

check "bounded exact-revision reviews, snapshots, handoffs and mixed acceptance" \
  emacs -Q --batch -L "$org/dispatch" -L "$org/edit" -l "$org/tests/review.el"

check "revision-checked task title and Scope updates, preservation and replay" \
  emacs -Q --batch -L "$org/dispatch" -L "$org/edit" -l "$org/tests/content.el"

# A run lists Jon's agenda files once, before it takes the lock, and skips its pass when the lock stays taken.
lockroot="$fixture/lockrun"
mkdir -p "$lockroot/work/one"
printf '* AUTO Locked task :kit:\n' >"$lockroot/work/one/one.org"
counter="$fixture/init-loads"
printf '(with-temp-buffer (insert "load\\n") (append-to-file (point-min) (point-max) "%s"))\n(setq org-agenda-files (list "%s"))\n' "$counter" "$lockroot/work/one/one.org" >"$fixture/counting-init.el"
lockrun() { ORG_DISPATCH_ROOT="$lockroot/work" ORG_DISPATCH_EMACS_INIT="$fixture/counting-init.el" XDG_STATE_HOME="$fixture/lockstate" "$dispatch" run >/dev/null 2>&1 || true; }
pending="$fixture/lockstate/org-dispatch/pending.json"
flock "$XDG_RUNTIME_DIR/org-dispatch.lock" sleep 8 &
holder=$!
sleep 0.3
started=$(date +%s)
lockrun
check "a run skips its pass while the lock stays taken" test ! -e "$pending"
check "a run gives up on the lock within its wait" test $(( $(date +%s) - started )) -lt 8
kill "$holder" 2>/dev/null || true
wait "$holder" 2>/dev/null || true
rm -f "$counter"
lockrun
check "a run with the lock free makes its pass" test -e "$pending"
check "a run loads Jon's Emacs config once, however many steps want the agenda files" test "$(wc -l <"$counter")" -eq 1

# The source byte-compiles without warnings.
cp "$org/dispatch/org-dispatch.el" "$fixture/org-dispatch.el"
compile=$(emacs -Q --batch --eval '(setq byte-compile-error-on-warn t)' -f batch-byte-compile "$fixture/org-dispatch.el" 2>&1 | grep -v '^Loading' || true)
check "org-dispatch.el byte-compiles cleanly" test -z "$compile"
cp "$org/edit/org-review.el" "$fixture/org-review.el"
compile=$(emacs -Q --batch -L "$org/dispatch" -L "$org/edit" --eval '(setq byte-compile-error-on-warn t)' -f batch-byte-compile "$fixture/org-review.el" 2>&1 | grep -v '^Loading' || true)
check "org-review.el byte-compiles cleanly" test -z "$compile"

if ((failures)); then
  echo "$failures failed"
  exit 1
fi
echo "all passed"
